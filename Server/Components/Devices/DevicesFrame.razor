@attribute [Authorize]
@inherits AuthComponentBase

<PageHeader Title="Dispositivos"
            Subtitle="Computadores com o agente instalado na sua organização."
            Icon="fa-solid fa-display">
    <Actions>
        <AlertsFrame />
        @if (Permissions.ManageDevices)
        {
            <a class="btn btn-secondary" href="deploy">
                <i class="fa-solid fa-plus"></i> Adicionar dispositivo
            </a>
        }
        <button class="btn btn-primary" @onclick="HandleRefreshClicked">
            <i class="fa-solid fa-rotate"></i> Atualizar
        </button>
    </Actions>
</PageHeader>

<div @onclick="ClearSelectedCard">
    <div class="stat-grid">
        <button type="button" class="stat-tile @(!_hideOfflineDevices ? "active" : "")" title="Mostrar todos" @onclick="ShowAllDevices" @onclick:stopPropagation>
            <span class="stat-icon"><i class="fa-solid fa-display"></i></span>
            <span>
                <span class="stat-value d-block">@_allDevices.Count</span>
                <span class="stat-label">Dispositivos</span>
            </span>
        </button>
        <button type="button" class="stat-tile @(_hideOfflineDevices ? "active" : "")" title="Mostrar somente online" @onclick="ShowOnlineDevices" @onclick:stopPropagation>
            <span class="stat-icon success"><i class="fa-solid fa-signal"></i></span>
            <span>
                <span class="stat-value d-block">@OnlineCount</span>
                <span class="stat-label">Online agora</span>
            </span>
        </button>
        <div class="stat-tile">
            <span class="stat-icon muted"><i class="fa-solid fa-moon"></i></span>
            <span>
                <span class="stat-value d-block">@(_allDevices.Count - OnlineCount)</span>
                <span class="stat-label">Offline</span>
            </span>
        </div>
        <div class="stat-tile">
            <span class="stat-icon warning"><i class="fa-solid fa-check-double"></i></span>
            <span>
                <span class="stat-value d-block">@SelectedCount</span>
                <span class="stat-label">Selecionados</span>
            </span>
        </div>
    </div>

    <div class="toolbar" @onclick:stopPropagation>
        <div class="grow input-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="form-control"
                   type="search"
                   placeholder="Nome, usuário, série, patrimônio, modelo ou tag"
                   aria-label="Pesquisar dispositivos"
                   @bind="_filter"
                   @bind:event="oninput" />
        </div>

        <div class="toolbar-group" title="Grupo de dispositivos">
            <select class="form-select" aria-label="Grupo de dispositivos" @bind="_selectedGroupId">
                <option value="@_deviceGroupAll">Todos os grupos</option>
                <option value="@_deviceGroupNone">Sem grupo</option>
                @foreach (var group in _deviceGroups)
                {
                    <option @key="group.ID" value="@group.ID">@group.Name</option>
                }
            </select>
            @if (Permissions.ManageDevices)
            {
                <button class="btn btn-secondary btn-icon" title="Ligar os dispositivos offline do grupo (Wake-on-LAN)" @onclick="WakeDevices">
                    <i class="fa-solid fa-power-off"></i>
                </button>
            }
        </div>

        <div class="toolbar-group" title="Ordenar">
            <select class="form-select" aria-label="Ordenar por" @bind="_selectedSortProperty">
                <option value="">Sem ordenação</option>
                @foreach (var prop in _sortableProperties)
                {
                    <option value="@prop.Name">@GetDisplayName(prop)</option>
                }
            </select>
            <button class="btn btn-secondary btn-icon" title="Inverter ordenação" @onclick="ToggleSortDirection">
                <i class="fa-solid @GetSortIcon()"></i>
            </button>
        </div>

        <label class="check-chip" for="hideOfflineDevicesCheckbox">
            <input id="hideOfflineDevicesCheckbox" type="checkbox" class="form-check-input" @bind="_hideOfflineDevices" />
            Só online
        </label>

        <button class="btn btn-secondary" @onclick="SelectAllCards">
            <i class="fa-regular @(SelectedCount > 0 ? "fa-square-minus" : "fa-square-check")"></i>
            @(SelectedCount > 0 ? "Limpar seleção" : "Selecionar todos")
        </button>
    </div>

    @{
        var displayed = DisplayedDevices;
    }

    @if (displayed.Length == 0)
    {
        <div class="empty-state mt-4">
            <div class="empty-icon"><i class="fa-solid fa-display"></i></div>
            @if (_allDevices.Count == 0)
            {
                <h3>Nenhum dispositivo ainda</h3>
                <p>Instale o agente nos computadores para que eles apareçam aqui.</p>
                <a class="btn btn-primary" href="deploy"><i class="fa-solid fa-rocket"></i> Implantar agente</a>
            }
            else
            {
                <h3>Nada encontrado</h3>
                <p>Nenhum dispositivo corresponde aos filtros atuais.</p>
                @if (_hideOfflineDevices)
                {
                    <button class="btn btn-secondary" @onclick="ShowAllDevices" @onclick:stopPropagation>Mostrar também os offline</button>
                }
            }
        </div>
    }
    else
    {
        <div id="deviceListDiv">
            @foreach (var device in displayed)
            {
                <CascadingValue Value="this">
                    <DeviceCard @key="device.ID" Device="device" />
                </CascadingValue>
            }
        </div>
    }

    <div class="pager" @onclick:stopPropagation>
        <div>
            @_filteredDevices.Count dispositivo(s) encontrados
        </div>
        <div class="toolbar-group">
            <button class="btn btn-sm btn-secondary btn-icon" title="Página anterior" disabled="@(_currentPage <= 1)" @onclick="PageDown">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <span>Página</span>
            <input id="currentPageInput" class="form-control form-control-sm" inputmode="numeric" aria-label="Página atual" @bind="_currentPage" @bind:event="oninput" />
            <span>de @TotalPages</span>
            <button class="btn btn-sm btn-secondary btn-icon" title="Próxima página" disabled="@(_currentPage >= TotalPages)" @onclick="PageUp">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
            <select class="form-select form-select-sm ms-2" aria-label="Dispositivos por página" @bind="_devicesPerPage">
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
                <option value="100">100 por página</option>
                <option value="200">200 por página</option>
            </select>
        </div>
    </div>

    @if (Permissions.Scripts)
    {
        <Terminal />
    }
</div>
