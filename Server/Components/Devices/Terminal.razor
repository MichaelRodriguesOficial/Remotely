@inherits AuthComponentBase

<div class="terminal-frame @_terminalOpenClass">
    <div class="terminal-header">
        <div>
            <button class="btn terminal-button" @onclick="ToggleTerminalOpen" aria-expanded="@(_terminalOpenClass == "open")">
                <i class="fa-solid fa-terminal"></i>
                <span>Terminal</span>
                <i class="fa-solid fa-chevron-up terminal-chevron"></i>
            </button>
        </div>
        <div class="text-end">
            <button class="btn terminal-button" @onclick="ShowQuickScripts">
                <i class="fa-solid fa-bolt"></i>
                <span>Scripts rápidos</span>
            </button>
        </div>

    </div>

    <div class="terminal-body">
        <div @ref="_terminalWindow" class="terminal-window px-2 py-1">
            
            @foreach (var line in TerminalStore.TerminalLines)
            {
                <div @key="line.Id" class="ms-1 terminal-line @line.ClassName" title="@line.Title">
                    @line.Text
                </div>
            }
        </div>
        <div>
            <div class="terminal-input-area px-2 mb-2">
                <div>
                    <button class="btn btn-sm terminal-help" title="Ajuda do terminal"
                            @onclick="ShowTerminalHelp">
                        <i class="fa-solid fa-circle-question"></i>
                    </button>

                </div>
                <div>
                    <select @bind="_shell" class="form-select form-select-sm terminal-shell" aria-label="Shell">
                        @foreach (var shell in Enum.GetValues(typeof(ScriptingShell)))
                        {
                            <option @key="shell" value="@shell">@shell</option>
                        }
                    </select>

                </div>
                <div>
                    <input @ref="_terminalInput" 
                           class="form-control form-control-sm terminal-input" 
                           placeholder="Digite um comando para os dispositivos selecionados"
                           spellcheck="false"
                           autocomplete="off"
                           @bind="InputText" 
                           @bind:event="oninput" 
                           @onkeypress="EvaluateInputKeypress"
                           @onkeydown="EvaluateKeyDown" />
                </div>
            </div>
        </div>

    </div>
</div>
