@attribute [Authorize]
@inherits AuthComponentBase

<div @ref="_card" class="device-card @_theme @GetCardStateClass() @(IsSelected ? "selected" : "") @(Device.IsOnline ? "online" : "offline")"
     @onclick="ExpandCard"
     @onclick:stopPropagation
     @oncontextmenu="ContextMenuOpening"
     @oncontextmenu:preventDefault="_state == DeviceCardState.Normal"
     @oncontextmenu:stopPropagation="_state == DeviceCardState.Normal">

    <div class="dc-head" @onclick="HandleHeaderClick"
         @onclick:stopPropagation="IsExpanded"
         @onclick:preventDefault="IsExpanded">
        <span class="os-icon @GetOsClass()" title="@Device.Platform">
            <i class="@GetOsIcon()"></i>
        </span>
        <div class="dc-title">
            <div class="dc-name" title="@Device.DeviceName">@Device.DeviceName</div>
            <div class="dc-sub" title="@GetSubtitle()">@GetSubtitle()</div>
        </div>
        <div class="dc-head-actions">
            @if (IsExpanded)
            {
                <button class="btn btn-ghost btn-icon btn-sm" title="Abrir detalhes em nova aba"
                        @onclick:stopPropagation
                        @onclick="OpenDeviceDetails">
                    <i class="fa-solid fa-up-right-from-square"></i>
                </button>
                <button class="btn btn-ghost btn-icon btn-sm" title="Recolher">
                    <i class="fa-solid fa-chevron-up"></i>
                </button>
            }
            <input type="checkbox"
                   class="form-check-input dc-check"
                   title="Selecionar"
                   aria-label="Selecionar @Device.DeviceName"
                   checked="@IsSelected"
                   @onchange="ToggleIsSelected"
                   @onclick:stopPropagation />
        </div>
    </div>

    <div class="dc-status">
        @if (!Device.IsOnline)
        {
            <span class="pill">Offline</span>
            <span class="dc-muted" title="Última conexão">@GetLastSeen()</span>
        }
        else if (IsOutdated)
        {
            <span class="pill warning" title="Versão @Device.AgentVersion">Agente desatualizado</span>
        }
        else
        {
            <span class="pill success">Online</span>
        }
        @if (!string.IsNullOrWhiteSpace(Device.CurrentUser))
        {
            var (userName, fullName) = DeviceDisplay.GetUser(Device, NameFormat);
            <span class="dc-user" title="@(fullName is null ? $"Usuário conectado: {userName}" : $"Usuário conectado: {fullName} ({userName})")">
                <i class="fa-regular fa-user"></i>
                @if (fullName is not null)
                {
                    <span class="dc-user-name">@fullName</span>
                    <span class="dc-user-login">@userName</span>
                }
                else
                {
                    @userName
                }
            </span>
        }
    </div>

    <div class="dc-metrics">
        <div class="dc-metric">
            <div class="dc-metric-label"><span>CPU</span><span>@FormatPercent(Device.CpuUtilization)</span></div>
            <div class="meter @GetMeterClass(Device.CpuUtilization)"><span style="width: @GetMeterWidth(Device.CpuUtilization)"></span></div>
        </div>
        <div class="dc-metric">
            <div class="dc-metric-label"><span>Memória</span><span>@FormatPercent(Device.UsedMemoryPercent)</span></div>
            <div class="meter @GetMeterClass(Device.UsedMemoryPercent)"><span style="width: @GetMeterWidth(Device.UsedMemoryPercent)"></span></div>
        </div>
        <div class="dc-metric">
            <div class="dc-metric-label"><span>Disco</span><span>@FormatPercent(Device.UsedStoragePercent)</span></div>
            <div class="meter @GetMeterClass(Device.UsedStoragePercent)"><span style="width: @GetMeterWidth(Device.UsedStoragePercent)"></span></div>
        </div>
    </div>

    @if (!IsExpanded)
    {
        <div class="dc-actions">
            @if (_permissions.RemoteControl)
            {
            <button class="btn btn-sm btn-primary" title="Controle remoto"
                    disabled="@(!Device.IsOnline)"
                    @onclick="() => StartRemoteControl(false)"
                    @onclick:stopPropagation>
                <i class="fa-solid fa-desktop"></i> Conectar
            </button>
            <button class="btn btn-sm btn-secondary btn-icon" title="Chat"
                    disabled="@(!Device.IsOnline)"
                    @onclick="StartChat"
                    @onclick:stopPropagation>
                <i class="fa-regular fa-comment"></i>
            </button>
            <button class="btn btn-sm btn-secondary btn-icon" title="Somente visualizar"
                    disabled="@(!Device.IsOnline)"
                    @onclick="() => StartRemoteControl(true)"
                    @onclick:stopPropagation>
                <i class="fa-regular fa-eye"></i>
            </button>
            }
            else
            {
                <span class="dc-locked" title="Seu perfil não permite acesso remoto">
                    <i class="fa-solid fa-lock"></i> Sem acesso remoto
                </span>
            }
            <span class="dc-more" title="Clique no card para ver detalhes">
                <i class="fa-solid fa-ellipsis"></i>
            </span>
        </div>
    }
    else
    {
        <div class="dc-expanded">
            <div class="dc-toolbar">
                @if (_permissions.RemoteControl)
                {
                <button class="btn btn-primary" disabled="@(!Device.IsOnline)" @onclick="() => StartRemoteControl(false)">
                    <i class="fa-solid fa-desktop"></i> Controle remoto
                </button>
                <button class="btn btn-secondary" disabled="@(!Device.IsOnline)" @onclick="() => StartRemoteControl(true)">
                    <i class="fa-regular fa-eye"></i> Somente visualizar
                </button>
                <button class="btn btn-secondary" disabled="@(!Device.IsOnline)" @onclick="StartChat">
                    <i class="fa-regular fa-comment"></i> Chat
                </button>
                }
                @if (!_permissions.ManageDevices)
                {
                    <button class="btn btn-secondary" @onclick="OpenDeviceDetails">
                        <i class="fa-solid fa-up-right-from-square"></i> Detalhes
                    </button>
                }
                @if (_permissions.ManageDevices || _permissions.Scripts)
                {
                <DropdownButton DropDownMenuClass="dropdown-menu-end" ButtonClass="btn-secondary">
                    <ButtonContent>
                        <i class="fa-solid fa-ellipsis"></i> Mais
                    </ButtonContent>
                    <ChildListItems>
                        @if (_permissions.Scripts)
                        {
                            <li>
                                <button class="dropdown-item" disabled="@(!Device.IsOnline)" @onclick='() => _shellTab = "terminal"'>
                                    <i class="fa-solid fa-terminal"></i> Terminal
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" disabled="@(!Device.IsOnline)" @onclick='() => _shellTab = "scripts"'>
                                    <i class="fa-solid fa-bolt"></i> Scripts rápidos
                                </button>
                            </li>
                        }
                        @if (_permissions.ManageDevices)
                        {
                            @if (_permissions.Scripts)
                            {
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <button class="dropdown-item" @onclick="() => WakeDevice()">
                                    <i class="fa-solid fa-bolt"></i> Ligar (Wake-on-LAN)
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" disabled="@(!Device.IsOnline)" @onclick="() => PowerAction(restart: true)">
                                    <i class="fa-solid fa-rotate-right"></i> Reiniciar
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" disabled="@(!Device.IsOnline)" @onclick="() => PowerAction(restart: false)">
                                    <i class="fa-solid fa-power-off"></i> Desligar
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" disabled="@(!Device.IsOnline)" @onclick="() => _sendFileOpen = true">
                                    <i class="fa-solid fa-upload"></i> Enviar arquivo...
                                </button>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <button class="dropdown-item text-danger" @onclick="UninstallAgent">
                                    <i class="fa-solid fa-trash-can"></i> Desinstalar agente
                                </button>
                            </li>
                        }
                    </ChildListItems>
                </DropdownButton>
                }
                @if (!string.IsNullOrWhiteSpace(_permissions.ProfileName))
                {
                    <span class="pill accent no-dot ms-auto align-self-center" title="Perfil de acesso">
                        <i class="fa-solid fa-id-badge me-1"></i>@_permissions.ProfileName
                    </span>
                }
            </div>

            <div class="dc-columns">
                <section>
                    <h3 class="dc-section-title">Computador</h3>
                    <DeviceComputerInfo Device="Device" Inventory="_inventory" NameFormat="NameFormat" Compact="true" ShowSensitive="@(User?.IsAdministrator == true)" />
                </section>

                <section>
                    <h3 class="dc-section-title">Identificação</h3>
                    <EditForm Model="Device" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <fieldset disabled="@(!_permissions.ManageDevices)">

                        <div class="mb-3">
                            <label class="form-label" for="alias-@Device.ID">Apelido</label>
                            <InputText id="@($"alias-{Device.ID}")" class="form-control" placeholder="Ex.: Recepção 01" @bind-Value="@Device.Alias" />
                            <ValidationMessage For="() => Device.Alias" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="group-@Device.ID">Grupo</label>
                            <InputSelect id="@($"group-{Device.ID}")" @bind-Value="Device.DeviceGroupID" class="form-select">
                                <option value="">Nenhum</option>
                                @foreach (var group in _deviceGroups)
                                {
                                    <option @key="group.ID" value="@group.ID">@group.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Device.DeviceGroupID" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="asset-@Device.ID">Número de inventário</label>
                                <InputText id="@($"asset-{Device.ID}")" class="form-control" placeholder="Placa de patrimônio" @bind-Value="Device.AssetTag" />
                                <ValidationMessage For="() => Device.AssetTag" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="location-@Device.ID">Localização</label>
                                <InputText id="@($"location-{Device.ID}")" class="form-control" placeholder="Ex.: Matriz · 2º andar" @bind-Value="Device.Location" />
                                <ValidationMessage For="() => Device.Location" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="tags-@Device.ID">Tags</label>
                            <InputText id="@($"tags-{Device.ID}")" @bind-Value="Device.Tags" class="form-control" placeholder="Separe por vírgula" />
                            <ValidationMessage For="() => Device.Tags" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="notes-@Device.ID">Observações</label>
                            <InputTextArea id="@($"notes-{Device.ID}")" @bind-Value="Device.Notes" class="form-control" rows="4"></InputTextArea>
                            <ValidationMessage For="() => Device.Notes" />
                        </div>

                        <ValidationSummary />

                        @if (_permissions.ManageDevices)
                        {
                            <div class="text-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-floppy-disk"></i> Salvar
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="form-text mb-0"><i class="fa-solid fa-lock me-1"></i> Seu perfil não permite editar dispositivos.</p>
                        }
                        </fieldset>
                    </EditForm>
                </section>
            </div>
        </div>
    }
    @if (_shellTab is not null)
    {
        <DeviceShellDialog Device="Device" Tab="@_shellTab" OnClose="() => _shellTab = null" />
    }

    @if (_sendFileOpen)
    {
        <SendFileDialog Device="Device" OnClose="() => _sendFileOpen = false" />
    }
</div>
