@using Remotely.Shared.Models.Diagnostics
@using Remotely.Server.Models.Messages
@inherits AuthComponentBase

<section class="panel diag-launcher">
    <div class="diag-launcher-head">
        <div>
            <h2 class="panel-title"><i class="fa-solid fa-stethoscope"></i> Novo diagnóstico</h2>
            <p class="panel-description mb-0">Escolha os testes. O agente roda na máquina e o resultado aparece abaixo, teste a teste.</p>
        </div>
        <div class="diag-launcher-actions">
            @if (Permissions.Repairs)
            {
                <div class="dropdown">
                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" disabled="@(!CanRepair)"
                            title="@(CanRepair ? "Executar um reparo" : "Disponível com o dispositivo online")">
                        <i class="fa-solid fa-wrench"></i> Reparos
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end diag-repair-menu">
                        <li><h6 class="dropdown-header">Executar no dispositivo</h6></li>
                        @foreach (var repair in DiagnosticRepairs.All.Where(x => x.Target != RepairTargetKind.Device && DiagnosticRepairs.IsAvailable(x, Device.Platform)))
                        {
                            <li>
                                <button type="button" class="dropdown-item" @onclick="() => OpenRepair(repair, null)">
                                    <i class="@repair.Icon"></i>
                                    <span>@repair.Name</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }
            <button type="button" class="btn btn-ghost btn-sm" @onclick="SelectQuick">Só os rápidos</button>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _selected.Clear()">Limpar</button>
            <button type="button" class="btn btn-primary" disabled="@(!CanRun || _selected.Count == 0 || _isStarting)" @onclick="Start">
                <i class="fa-solid @(_isStarting ? "fa-circle-notch fa-spin" : "fa-play")"></i>
                Executar @(_selected.Count > 0 ? $"({_selected.Count})" : "")
            </button>
        </div>
    </div>

    @if (!Device.IsOnline)
    {
        <div class="diag-notice"><i class="fa-solid fa-plug-circle-xmark"></i> O dispositivo está offline. Os testes ficam disponíveis quando ele conectar.</div>
    }
    else if (!Permissions.ManageDevices)
    {
        <div class="diag-notice"><i class="fa-solid fa-lock"></i> Seu perfil não permite executar diagnósticos; você pode ver o histórico.</div>
    }

    <div class="diag-section-label"><i class="fa-solid fa-bolt"></i> Rápidos <span>segundos, o usuário nem percebe</span></div>
    <div class="diag-tiles">
        @foreach (var test in DiagnosticTests.All.Where(x => !x.Heavy))
        {
            @TestTile(test)
        }
    </div>

    <div class="diag-section-label"><i class="fa-solid fa-weight-hanging"></i> Pesados <span>deixam a máquina lenta por alguns minutos ou reiniciam</span></div>
    <div class="diag-tiles">
        @foreach (var test in DiagnosticTests.All.Where(x => x.Heavy))
        {
            @TestTile(test)
        }
    </div>
</section>

<div class="diag-layout">
    <aside class="panel diag-history-panel">
        <div class="panel-header">
            <h2 class="panel-title"><i class="fa-solid fa-clock-rotate-left"></i> Histórico</h2>
            <span class="pill no-dot">@_runs.Count</span>
        </div>
        @if (_runs.Count == 0)
        {
            <p class="text-muted small mb-0">Nenhum diagnóstico executado ainda.</p>
        }
        else
        {
            <div class="diag-history">
                @foreach (var run in _runs)
                {
                    var status = GetRunStatus(run);
                    var count = run.Tests.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
                    var runRepair = DiagnosticRepairs.FromTestId(run.Tests);
                    <button type="button" class="diag-history-item @(run.ID == _selectedRunId ? "active" : "")" @onclick="() => SelectRun(run.ID)">
                        <span class="diag-history-status diag-bg-@status.ToString().ToLowerInvariant()"><i class="@(runRepair is null ? StatusIcon(status, colored: false) : "fa-solid fa-wrench")"></i></span>
                        <span class="diag-history-text">
                            <strong>@run.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                            @if (runRepair is null)
                            {
                                <span>@RunTitle(status) · @count teste(s)</span>
                            }
                            else
                            {
                                <span>Reparo: @runRepair.Name · @RunTitle(status, isRepair: true).ToLowerInvariant()</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(run.RequestedBy))
                            {
                                <span class="text-truncate">@run.RequestedBy</span>
                            }
                        </span>
                    </button>
                }
            </div>
        }
    </aside>

    <div class="diag-result">
        @if (_selectedReport is null || _selectedRun is null)
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-stethoscope"></i></div>
                <h3>Nenhum resultado ainda</h3>
                <p>Escolha os testes acima e clique em Executar.</p>
            </div>
        }
        else
        {
            var runStatus = GetRunStatus(_selectedRun);
            var isRepairRun = DiagnosticRepairs.IsRepairRun(_selectedRun.Tests);
            <section class="panel diag-summary diag-@runStatus.ToString().ToLowerInvariant()">
                <span class="diag-summary-icon diag-bg-@runStatus.ToString().ToLowerInvariant()"><i class="@StatusIcon(runStatus, colored: false)"></i></span>
                <div class="diag-summary-text">
                    <h2>@(isRepairRun ? $"{DiagnosticRepairs.FromTestId(_selectedRun.Tests)?.Name}: {RunTitle(runStatus, isRepair: true).ToLowerInvariant()}" : RunTitle(runStatus))</h2>
                    <div class="small text-muted">
                        @_selectedRun.StartedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(_selectedRun.RequestedBy))
                        {
                            <span> · por @_selectedRun.RequestedBy</span>
                        }
                        @if (_selectedRun.FinishedAt is { } finished)
                        {
                            <span> · durou @FormatDuration(finished - _selectedRun.StartedAt)</span>
                        }
                    </div>
                    @if (runStatus == DiagnosticStatus.Skipped && _selectedRun.Data is null)
                    {
                        <div class="small text-warning mt-1">
                            <i class="fa-solid fa-circle-info"></i> O agente não respondeu. Ele pode estar desligado ou numa versão antiga: atualize o agente em Configuração do servidor.
                        </div>
                    }
                    <div class="diag-counts @(isRepairRun ? "d-none" : "")">
                        <span class="pill success">@_selectedReport.Tests.Count(x => x.Status == DiagnosticStatus.Ok) ok</span>
                        <span class="pill warning">@_selectedReport.Tests.Count(x => x.Status == DiagnosticStatus.Warning) atenção</span>
                        <span class="pill danger">@_selectedReport.Tests.Count(x => x.Status == DiagnosticStatus.Error) problema(s)</span>
                    </div>
                </div>
                <ReportActions FileName="@($"diagnostico-{Device.DeviceName}-{_selectedRun.StartedAt.ToLocalTime():yyyy-MM-dd-HHmm}")"
                               EmailSubject="@($"{(isRepairRun ? "Reparo" : "Diagnóstico")} de {Device.DeviceName} ({_selectedRun.StartedAt.ToLocalTime():dd/MM/yyyy HH:mm}): {RunTitle(runStatus, isRepairRun)}")"
                               Html="BuildHtml"
                               Csv="BuildCsv"
                               Json="BuildJson"
                               Disabled="@(runStatus == DiagnosticStatus.Running)" />
            </section>

            <div class="diag-overview @(isRepairRun ? "d-none" : "")">
                @foreach (var test in _selectedReport.Tests)
                {
                    <a class="diag-overview-item diag-border-@test.Status.ToString().ToLowerInvariant()" href="@($"device-details/{Device.ID}/diagnostics#diag-{test.Id}")"
                       @onclick:preventDefault @onclick="() => ScrollTo(test.Id)">
                        <i class="@TestIcon(test.Id)"></i>
                        <span>@test.Name</span>
                        <i class="@StatusIcon(test.Status) ms-auto"></i>
                    </a>
                }
            </div>

            @foreach (var test in _selectedReport.Tests)
            {
                <section id="@($"diag-{test.Id}")" class="panel diag-test diag-border-@test.Status.ToString().ToLowerInvariant()">
                    <div class="diag-test-head">
                        <span class="diag-test-icon"><i class="@TestIcon(test.Id)"></i></span>
                        <div class="flex-grow-1 min-w-0">
                            <h3>@test.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(test.Summary))
                            {
                                <p>@test.Summary</p>
                            }
                        </div>
                        <span class="pill @PillClass(test.Status)">@StatusLabel(test.Status)</span>
                    </div>
                    @if (test.Items.Count > 0)
                    {
                        @foreach (var group in test.Items.GroupBy(x => x.Group))
                        {
                            @if (!string.IsNullOrWhiteSpace(group.Key))
                            {
                                <div class="diag-item-group">@group.Key</div>
                            }
                            <div class="diag-items">
                                @foreach (var item in group)
                                {
                                    <div class="diag-item diag-item-@item.Status.ToString().ToLowerInvariant()">
                                        <i class="@StatusIcon(item.Status)"></i>
                                        <span class="diag-item-label">@item.Label</span>
                                        <span class="diag-item-value">
                                            @item.Value
                                            @if (!string.IsNullOrWhiteSpace(item.Hint))
                                            {
                                                <small>@item.Hint</small>
                                            }
                                        </span>
                                        <span class="diag-item-action">
                                            @if (DiagnosticRepairs.Get(item.Repair) is { } itemRepair &&
                                                 Permissions.Repairs &&
                                                 DiagnosticRepairs.IsAvailable(itemRepair, Device.Platform) &&
                                                 item.Status is DiagnosticStatus.Warning or DiagnosticStatus.Error)
                                            {
                                                <button type="button" class="btn btn-sm diag-fix-btn" disabled="@(!CanRepair)"
                                                        title="@(CanRepair ? itemRepair.Name : "Disponível com o dispositivo online")"
                                                        @onclick="() => OpenRepair(itemRepair, item.RepairTarget)">
                                                    <i class="fa-solid fa-wrench"></i> Corrigir
                                                </button>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </section>
            }
        }
    </div>
</div>

@if (_repair is { } dialogRepair)
{
    <div class="rm-dialog-backdrop" @onclick="CloseRepair"></div>
    <div class="rm-dialog panel" role="dialog" aria-modal="true" aria-labelledby="repair-dialog-title">
        <div class="rm-dialog-head">
            <span class="diag-tile-icon"><i class="@dialogRepair.Icon"></i></span>
            <div class="min-w-0">
                <h2 id="repair-dialog-title">@dialogRepair.Name</h2>
                <p>@dialogRepair.Description</p>
            </div>
            <button type="button" class="btn btn-ghost btn-icon btn-sm ms-auto" title="Fechar" @onclick="CloseRepair"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <dl class="rm-dialog-facts">
            <dt>Dispositivo</dt>
            <dd>@Device.DeviceName</dd>
            @if (dialogRepair.Target == RepairTargetKind.Drive)
            {
                <dt>Unidade</dt>
                <dd>
                    <input class="form-control form-control-sm rm-dialog-drive" maxlength="2" @bind="_repairTarget" @bind:event="oninput" aria-label="Unidade" />
                </dd>
            }
            else if (dialogRepair.Target == RepairTargetKind.Device)
            {
                <dt>Dispositivo com erro</dt>
                <dd class="mono small text-break">@_repairTarget</dd>
            }
            else if (dialogRepair.Target == RepairTargetKind.RebootTime)
            {
                <dt>Quando</dt>
                <dd>
                    <div class="rm-dialog-when">
                        <select class="form-select form-select-sm" @bind="_rebootChoice" aria-label="Quando reiniciar">
                            @foreach (var option in DiagnosticRepairs.RebootOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                            <option value="time">Num horário...</option>
                        </select>
                        @if (_rebootChoice == "time")
                        {
                            <input type="time" class="form-control form-control-sm" @bind="_rebootTime" aria-label="Horário" />
                        }
                    </div>
                </dd>
            }
            <dt>Duração</dt>
            <dd>@dialogRepair.Duration</dd>
        </dl>

        @if (dialogRepair.Reboots)
        {
            <div class="diag-notice"><i class="fa-solid fa-triangle-exclamation"></i> O usuário vê um aviso na tela e o computador reinicia no horário escolhido. Trabalho não salvo é perdido.</div>
        }
        else if (dialogRepair.NeedsRebootAfter)
        {
            <div class="diag-notice"><i class="fa-solid fa-circle-info"></i> Só tem efeito depois de reiniciar. Ao terminar, aparece o botão para agendar o reinício.</div>
        }
        else if (dialogRepair.RetestTests.Length > 0)
        {
            <div class="rm-dialog-note"><i class="fa-solid fa-rotate"></i> Ao terminar, o teste relacionado roda de novo para mostrar se resolveu.</div>
        }

        <div class="rm-dialog-actions">
            <button type="button" class="btn btn-ghost" @onclick="CloseRepair">Cancelar</button>
            <button type="button" class="btn btn-primary" disabled="@(_isStartingRepair || !CanRepair)" @onclick="ConfirmRepair">
                <i class="fa-solid @(_isStartingRepair ? "fa-circle-notch fa-spin" : "fa-wrench")"></i> Executar reparo
            </button>
        </div>
    </div>
}

@code {
    private readonly HashSet<string> _selected = [DiagnosticTests.Disks, DiagnosticTests.Battery, DiagnosticTests.Devices, DiagnosticTests.Network, DiagnosticTests.System];
    private List<DeviceDiagnosticRun> _runs = [];
    private string? _selectedRunId;
    private DeviceDiagnosticRun? _selectedRun;
    private DiagnosticReport? _selectedReport;
    private bool _isStarting;
    private DiagnosticRepairs.RepairInfo? _repair;
    private string? _repairTarget;
    private string _rebootChoice = "5";
    private TimeOnly? _rebootTime = new(22, 0);
    private bool _isStartingRepair;

    [Parameter, EditorRequired]
    public Device Device { get; set; } = null!;

    [Inject]
    private IDataService DataService { get; init; } = null!;

    [Inject]
    private ICircuitConnection CircuitConnection { get; init; } = null!;

    [Inject]
    private IJsInterop JsInterop { get; init; } = null!;

    [Inject]
    private IToastService ToastService { get; init; } = null!;

    [Inject]
    private Microsoft.JSInterop.IJSRuntime JsRuntime { get; init; } = null!;

    private Remotely.Server.Models.UserNameDisplayFormat _nameFormat;

    private bool CanRun => Device.IsOnline && Permissions.ManageDevices;

    private bool CanRepair => Device.IsOnline && Permissions.Repairs;

    private void OpenRepair(DiagnosticRepairs.RepairInfo repair, string? target)
    {
        _repair = repair;
        _repairTarget = target ?? (repair.Target == RepairTargetKind.Drive ? "C:" : null);
        _rebootChoice = "5";
    }

    private void CloseRepair() => _repair = null;

    private async Task ConfirmRepair()
    {
        if (_repair is null || !CanRepair)
        {
            return;
        }

        var target = _repair.Target switch
        {
            RepairTargetKind.RebootTime => _rebootChoice == "time" ? _rebootTime?.ToString("HH:mm") : _rebootChoice,
            RepairTargetKind.None => null,
            _ => _repairTarget
        };

        if (DiagnosticRepairs.NormalizeTarget(_repair, target) is null)
        {
            ToastService.ShowToast2(_repair.Target == RepairTargetKind.Drive ? "Informe a unidade, por exemplo C:." : "Escolha quando reiniciar.", Enums.ToastType.Warning);
            return;
        }

        _isStartingRepair = true;
        try
        {
            var result = await CircuitConnection.RunRepair(Device.ID, _repair.Id, target);
            if (!result.IsSuccess)
            {
                ToastService.ShowToast2(result.Reason, Enums.ToastType.Warning);
                return;
            }

            ToastService.ShowToast2($"{_repair.Name}: iniciado.", Enums.ToastType.Info);
            _repair = null;
            await LoadRuns(selectLatest: false);
            SelectRun(result.Value);
        }
        finally
        {
            _isStartingRepair = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        EnsureUserSet();
        _nameFormat = (await DataService.GetSettings()).UserNameDisplayFormat;
        await LoadRuns(selectLatest: true);

        await Register<DiagnosticsUpdatedMessage, string>(
            CircuitConnection.ConnectionId,
            HandleDiagnosticsUpdated);
    }

    private async Task HandleDiagnosticsUpdated(object subscriber, DiagnosticsUpdatedMessage message)
    {
        if (message.DeviceId != Device.ID)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            // Acompanha a execução nova automaticamente.
            var isNew = _runs.All(x => x.ID != message.RunId);
            var follow = _selectedRunId is null || _selectedRunId == message.RunId ||
                _runs.FirstOrDefault()?.ID == message.RunId ||
                (isNew && _selectedRunId == _runs.FirstOrDefault()?.ID);
            await LoadRuns(selectLatest: false);
            if (follow)
            {
                SelectRun(message.RunId);
            }
            StateHasChanged();
        });
    }

    private async Task LoadRuns(bool selectLatest)
    {
        _runs = await DataService.GetDiagnosticRuns(Device.ID);
        if (selectLatest && _runs.Count > 0)
        {
            SelectRun(_runs[0].ID);
        }
        else if (_selectedRunId is not null)
        {
            SelectRun(_selectedRunId);
        }
    }

    private void SelectRun(string runId)
    {
        _selectedRunId = runId;
        _selectedRun = _runs.FirstOrDefault(x => x.ID == runId);
        _selectedReport = DiagnosticSerializer.FromJson(_selectedRun?.Data);

        // Execução recém-criada, ainda sem resposta do agente.
        if (_selectedRun is not null && _selectedReport is null)
        {
            _selectedReport = new DiagnosticReport
            {
                RunId = _selectedRun.ID,
                StartedAt = _selectedRun.StartedAt,
                Tests = _selectedRun.Tests.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(id => new DiagnosticTestResult
                    {
                        Id = id,
                        Name = DiagnosticTests.Get(id)?.Name ?? DiagnosticRepairs.FromTestId(id)?.Name ?? id,
                        Status = DiagnosticStatus.Pending
                    })
                    .ToList()
            };
        }
    }

    private void SelectQuick()
    {
        _selected.Clear();
        foreach (var test in DiagnosticTests.All.Where(x => !x.Heavy))
        {
            _selected.Add(test.Id);
        }
    }

    private void Toggle(string id, bool value)
    {
        if (value)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private async Task Start()
    {
        if (!CanRun || _selected.Count == 0)
        {
            return;
        }

        if (_selected.Contains(DiagnosticTests.MemoryTest))
        {
            var confirmed = await JsInterop.Confirm(
                $"O teste de memória reinicia {Device.DeviceName} em 2 minutos (o usuário recebe um aviso) " +
                "e a máquina fica 10 a 20 minutos testando a memória antes de voltar ao Windows. Continuar?");
            if (!confirmed)
            {
                return;
            }
        }
        else if (DiagnosticTests.All.Any(x => x.Heavy && _selected.Contains(x.Id)))
        {
            var confirmed = await JsInterop.Confirm(
                $"Os testes pesados deixam {Device.DeviceName} lento por cerca de 2 minutos. Continuar?");
            if (!confirmed)
            {
                return;
            }
        }

        _isStarting = true;
        try
        {
            var result = await CircuitConnection.RunDiagnostics(Device.ID, _selected.ToArray());
            if (!result.IsSuccess)
            {
                ToastService.ShowToast2(result.Reason, Enums.ToastType.Warning);
                return;
            }

            ToastService.ShowToast2("Diagnóstico iniciado. O resultado aparece aqui conforme os testes terminam.", Enums.ToastType.Info);
            await LoadRuns(selectLatest: false);
            SelectRun(result.Value);
        }
        finally
        {
            _isStarting = false;
        }
    }

    private DiagnosticStatus GetRunStatus(DeviceDiagnosticRun run)
    {
        if (run.Status == "Running" && DiagnosticRepairs.IsRepairRun(run.Tests))
        {
            // O agente responde na hora ao começar o reparo; sem resposta = agente antigo ou desligado.
            var elapsed = DateTimeOffset.Now - run.StartedAt;
            return (run.Data is null && elapsed > TimeSpan.FromMinutes(3)) || elapsed > TimeSpan.FromMinutes(100)
                ? DiagnosticStatus.Skipped
                : DiagnosticStatus.Running;
        }

        if (run.Status == "Running")
        {
            // Agente antigo (sem diagnóstico), desligado no meio ou reiniciado pelo teste de memória.
            var limit = run.Tests.Contains(DiagnosticTests.MemoryTest) ? TimeSpan.FromMinutes(5) : TimeSpan.FromMinutes(20);
            return DateTimeOffset.Now - run.StartedAt > limit && run.Data is null
                ? DiagnosticStatus.Skipped
                : DiagnosticStatus.Running;
        }

        return Enum.TryParse<DiagnosticStatus>(run.Status, out var status) ? status : DiagnosticStatus.Info;
    }

    private static string RunTitle(DiagnosticStatus status, bool isRepair) => !isRepair ? RunTitle(status) : status switch
    {
        DiagnosticStatus.Ok => "Concluído",
        DiagnosticStatus.Warning => "Concluído com avisos",
        DiagnosticStatus.Error => "Não concluído",
        DiagnosticStatus.Running or DiagnosticStatus.Pending => "Executando...",
        DiagnosticStatus.Skipped => "Não executado",
        _ => "Reparo"
    };

    private static string RunTitle(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Ok => "Tudo certo",
        DiagnosticStatus.Warning => "Pontos de atenção",
        DiagnosticStatus.Error => "Problemas encontrados",
        DiagnosticStatus.Running => "Executando...",
        DiagnosticStatus.Skipped => "Sem resposta do agente",
        _ => "Diagnóstico"
    };

    private static string StatusLabel(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Pending => "Na fila",
        DiagnosticStatus.Running => "Executando",
        DiagnosticStatus.Ok => "Ok",
        DiagnosticStatus.Warning => "Atenção",
        DiagnosticStatus.Error => "Problema",
        DiagnosticStatus.Skipped => "Não se aplica",
        _ => "Informação"
    };

    private static string StatusIcon(DiagnosticStatus status, bool colored = true) => status switch
    {
        DiagnosticStatus.Pending => "fa-regular fa-clock" + (colored ? " text-muted" : ""),
        DiagnosticStatus.Running => "fa-solid fa-circle-notch fa-spin" + (colored ? " text-info" : ""),
        DiagnosticStatus.Ok => "fa-solid fa-circle-check" + (colored ? " text-success" : ""),
        DiagnosticStatus.Warning => "fa-solid fa-triangle-exclamation" + (colored ? " text-warning" : ""),
        DiagnosticStatus.Error => "fa-solid fa-circle-xmark" + (colored ? " text-danger" : ""),
        DiagnosticStatus.Skipped => "fa-solid fa-circle-minus" + (colored ? " text-muted" : ""),
        _ => "fa-solid fa-circle-info" + (colored ? " text-muted" : "")
    };

    private static string PillClass(DiagnosticStatus status) => status switch
    {
        DiagnosticStatus.Ok => "success",
        DiagnosticStatus.Warning => "warning",
        DiagnosticStatus.Error => "danger",
        DiagnosticStatus.Running => "accent",
        _ => ""
    };

    private static string TestIcon(string id) => id switch
    {
        DiagnosticTests.Disks => "fa-solid fa-hard-drive",
        DiagnosticTests.Battery => "fa-solid fa-battery-three-quarters",
        DiagnosticTests.Devices => "fa-solid fa-microchip",
        DiagnosticTests.Network => "fa-solid fa-wifi",
        DiagnosticTests.System => "fa-solid fa-shield-halved",
        DiagnosticTests.DiskSpeed => "fa-solid fa-gauge-high",
        DiagnosticTests.CpuStress => "fa-solid fa-temperature-high",
        DiagnosticTests.MemoryTest => "fa-solid fa-memory",
        _ => DiagnosticRepairs.FromTestId(id)?.Icon ?? "fa-solid fa-vial"
    };

    private async Task ScrollTo(string testId) =>
        await JsRuntime.InvokeVoidAsync("remotelyScrollIntoView", $"diag-{testId}");

    private string BuildHtml() =>
        _selectedRun is null || _selectedReport is null
            ? string.Empty
            : ReportBuilder.DiagnosticsHtml(Device, _selectedRun, _selectedReport, _nameFormat);

    private byte[] BuildCsv() =>
        _selectedReport is null ? [] : ReportBuilder.DiagnosticsCsv(Device, _selectedReport);

    private string BuildJson() =>
        _selectedReport is null ? "{}" : DiagnosticSerializer.ToJson(_selectedReport);

    private static string TestNames(string tests) =>
        string.Join(", ", tests.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => DiagnosticTests.Get(x)?.Name ?? x));

    private static string FormatDuration(TimeSpan span) =>
        span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes} min {span.Seconds} s" : $"{span.Seconds} s";

    private RenderFragment TestTile(DiagnosticTests.TestInfo test) => __builder =>
    {
        var id = $"diag-option-{test.Id}";
        var selected = _selected.Contains(test.Id);
        <label class="diag-tile @(selected ? "selected" : "") @(test.Heavy ? "heavy" : "")" for="@id">
            <input id="@id" type="checkbox" class="visually-hidden"
                   checked="@selected"
                   @onchange="e => Toggle(test.Id, e.Value is true)" />
            <span class="diag-tile-icon"><i class="@TestIcon(test.Id)"></i></span>
            <span class="diag-tile-body">
                <span class="diag-tile-name">
                    @test.Name
                    @if (test.RequiresRestart)
                    {
                        <span class="pill danger no-dot">reinicia</span>
                    }
                    else if (test.Heavy)
                    {
                        <span class="pill warning no-dot">pesado</span>
                    }
                </span>
                <span class="diag-tile-desc">@test.Description</span>
            </span>
            <span class="diag-tile-check"><i class="fa-solid @(selected ? "fa-square-check" : "fa-square")"></i></span>
        </label>
    };
}
