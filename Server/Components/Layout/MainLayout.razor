@using Remotely.Server.Components 
@using Remotely.Server.Auth 
@inherits LayoutComponentBase
@inject NavigationManager NavMan

<AuthorizeView Policy="@PolicyNames.TwoFactorRequired">
    <Authorized>
        <div class="page">
            <aside class="sidebar">
                <NavMenu />
            </aside>

            <main class="main">
                <div class="content">
                    @Body
                </div>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="gate">
            <div class="gate-card panel">
                <span class="page-header-icon mb-3" aria-hidden="true">
                    <i class="fa-solid fa-shield-halved"></i>
                </span>
                <h1 class="page-title">Ative a verificação em duas etapas</h1>
                <p class="page-subtitle mb-4">
                    O administrador exige autenticação em dois fatores. Configure seu app autenticador
                    (Microsoft Authenticator, Google Authenticator, Authy etc.) para continuar.
                </p>
                <button class="btn btn-primary btn-lg w-100" @onclick="NavigateToTwoFactor">
                    <i class="fa-solid fa-qrcode"></i> Configurar agora
                </button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    Ocorreu um erro inesperado.
    <a href="" class="reload">Recarregar</a>
    <a class="dismiss" title="Fechar">✕</a>
</div>

<ToastHarness />
<LoaderHarness />
<ModalHarness />

@code {
    private void NavigateToTwoFactor()
    {
        NavMan.NavigateTo("/Account/Manage/TwoFactorAuthentication", true);
    }
}