@inject AuthenticationStateProvider AuthProvider
@inject IDataService DataService
@inject IThemeProvider ThemeProvider

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="@(_theme == Theme.Dark ? "dark" : "light")" />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href="/favicon.ico" />
    <title>Remotely</title>
    <base href="/" />
    <link href="@Assets["css/site.css"]" rel="stylesheet" />
    <link href="@Assets["Remotely_Server.styles.css"]" rel="stylesheet" />
    <script src="@Assets["interop.js"]"></script>

    @if (_theme == Theme.Dark)
    {
        <link rel="stylesheet" href="/css/Themes/darkly.min.css" />
        <link rel="stylesheet" href="@Assets["css/Themes/darkly.custom.css"]" />
    }
    else
    {
        <link rel="stylesheet" href="/css/Themes/yeti.min.css" />
        <link rel="stylesheet" href="@Assets["css/Themes/yeti.custom.css"]" />
    }
    <link rel="stylesheet" href="/lib/fontawesome/css/all.min.css" />
    <!-- Com impressão digital no nome: o navegador pega o CSS novo a cada versão. -->
    <link rel="stylesheet" href="@Assets["css/modern.css"]" />

    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body class="@(_theme == Theme.Dark ? "theme-dark" : "theme-light")" data-interactive="@(RenderModeForPage is null ? "false" : "true")">
    <Routes @rendermode="RenderModeForPage" />

    @* Aviso exibido quando a conexão em tempo real (SignalR/WebSocket em /_blazor) não sobe.
       Sem ela as páginas carregam, mas nenhum botão responde. *@
    <div id="rm-offline-banner" class="rm-offline-banner" role="alert" hidden>
        <i class="fa-solid fa-plug-circle-exclamation"></i>
        <div>
            <strong>Sem conexão em tempo real com o servidor.</strong>
            <span>Os botões não respondem enquanto ela não for estabelecida. Se o Remotely estiver atrás de um proxy
                (Nginx, aaPanel, Cloudflare), libere WebSocket para <code>/_blazor</code>.</span>
        </div>
        <button type="button" class="btn btn-sm btn-light" onclick="location.reload()">Recarregar</button>
    </div>

    @* Tela de reconexão do Blazor (substitui a padrão, em inglês). *@
    <div id="components-reconnect-modal" class="rm-reconnect" data-nosnippet>
        <div class="rm-reconnect-card">
            <div class="rm-reconnect-spinner" aria-hidden="true"></div>
            <h2 class="rm-reconnect-show-text">Reconectando ao servidor...</h2>
            <h2 class="rm-reconnect-failed-text">Conexão perdida</h2>
            <h2 class="rm-reconnect-rejected-text">Sessão expirada</h2>
            <p class="rm-reconnect-show-text">A conexão caiu. Tentando de novo automaticamente.</p>
            <p class="rm-reconnect-failed-text">Não foi possível reconectar.</p>
            <p class="rm-reconnect-rejected-text">Recarregue a página para continuar.</p>
            <div class="rm-reconnect-actions">
                <button type="button" class="btn btn-secondary rm-reconnect-failed-text" onclick="Blazor.reconnect()">Tentar de novo</button>
                <button type="button" class="btn btn-primary" onclick="location.reload()">Recarregar página</button>
            </div>
        </div>
    </div>

    <script>
        // Downloads do cliente: informa ao servidor que a página está em https,
        // mesmo quando o proxy reverso não envia X-Forwarded-Proto.
        document.addEventListener("click", function (ev) {
            var link = ev.target && ev.target.closest ? ev.target.closest("a[href*='/api/ClientDownloads/']") : null;
            if (!link || location.protocol !== "https:" || link.href.indexOf("scheme=") >= 0) { return; }
            link.href = link.href + (link.href.indexOf("?") >= 0 ? "&" : "?") + "scheme=https";
        }, true);
        window.remotelyCircuitReady = function () {
            window.__remotelyCircuit = true;
            var banner = document.getElementById("rm-offline-banner");
            if (banner) { banner.hidden = true; }
        };
        if (document.body.dataset.interactive === "true") {
            setTimeout(function () {
                if (!window.__remotelyCircuit) {
                    var banner = document.getElementById("rm-offline-banner");
                    if (banner) { banner.hidden = false; }
                }
            }, 12000);
        }
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="/lib/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>

@code
{
    [CascadingParameter]
    public required HttpContext HttpContext { get; set; }

    private RemotelyUser? _user;
    private Theme _theme;

    protected override async Task OnInitializedAsync()
    {
        _theme = await ThemeProvider.GetEffectiveTheme();
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity is { IsAuthenticated: true } identity)
        {
            var userResult = await DataService.GetUserByName($"{identity.Name}");
            if (userResult.IsSuccess)
            {
                _user = userResult.Value;
            }
        }
        await base.OnInitializedAsync();
    }


    private IComponentRenderMode? RenderModeForPage => 
        HttpContext.Request.Path.StartsWithSegments("/Account")
            ? null
            : InteractiveServer;
}