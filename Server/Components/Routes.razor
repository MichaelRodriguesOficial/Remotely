@using Remotely.Server.Components.Account.Shared

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @* AuthorizeRouteView enforces [Authorize] attributes and policies during
           interactive (in-circuit) navigation.  A plain RouteView only relies on
           the endpoint middleware, which doesn't run for client-side navigation. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="container mt-5">
                        <div class="empty-state">
                            <span class="oi oi-lock-locked display-6 mb-3" aria-hidden="true"></span>
                            <h3>Access denied</h3>
                            <p class="text-muted">You don't have permission to view this page.</p>
                            <a class="btn btn-primary" href="">Go to Home</a>
                        </div>
                    </div>
                }
            </NotAuthorized>
            <Authorizing>
                <div class="container mt-5 text-muted">Checking permissions...</div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="container mt-5">
                <div class="empty-state">
                    <h3>Page not found</h3>
                    <p class="text-muted">The page you requested doesn't exist.</p>
                    <a class="btn btn-primary" href="">Go to Home</a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
