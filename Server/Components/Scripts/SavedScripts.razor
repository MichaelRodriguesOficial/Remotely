@inherits AuthComponentBase
@attribute [Authorize]

<div class="library">
    <aside class="panel library-side">
        <div class="panel-header mb-2">
            <h2 class="panel-title"><i class="fa-solid fa-book"></i> Biblioteca</h2>
            <button type="button" class="btn btn-sm btn-primary" @onclick="CreateNew"><i class="fa-solid fa-plus"></i> Novo</button>
        </div>
        <ScriptList Scripts="ParentPage.VisibleScripts"
                    SelectedId="@(_selectedScript.Id == Guid.Empty ? null : _selectedScript.Id)"
                    OnSelect="ScriptSelected"
                    ShowOnlyMine="ParentPage.ShowOnlyMyScripts"
                    ShowOnlyMineChanged="v => ParentPage.ShowOnlyMyScripts = v" />
    </aside>

    <section class="panel library-editor">
        <EditForm Model="_selectedScript" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />

            <div class="editor-head">
                <div class="min-w-0">
                    <h2 class="editor-title truncate">@(IsNew ? "Novo script" : _selectedScript.Name)</h2>
                    <p class="editor-sub">
                        @if (IsNew)
                        {
                            <span>Preencha os dados e salve para usar em execuções e agendamentos.</span>
                        }
                        else
                        {
                            <span>Criado por @(_selectedScript.Creator?.UserName ?? "—")</span>
                            @if (!CanModifyScript)
                            {
                                <span class="pill warning no-dot ms-2"><i class="fa-solid fa-lock"></i> Somente leitura</span>
                            }
                        }
                    </p>
                </div>
                <div class="editor-actions">
                    @if (!IsNew)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="() => ParentPage.OpenInRun(_selectedScript.Id)">
                            <i class="fa-solid fa-play"></i> Executar
                        </button>
                        <DropdownButton ButtonClass="btn-secondary btn-icon" DropDownMenuClass="dropdown-menu-end">
                            <ButtonContent><i class="fa-solid fa-ellipsis"></i></ButtonContent>
                            <ChildListItems>
                                <li><button type="button" class="dropdown-item" @onclick="() => ParentPage.OpenInSchedules(_selectedScript.Id)"><i class="fa-regular fa-calendar-plus"></i> Agendar</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="Duplicate"><i class="fa-regular fa-copy"></i> Duplicar</button></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><button type="button" class="dropdown-item text-danger" disabled="@(!CanDeleteScript)" @onclick="DeleteSelectedScript"><i class="fa-solid fa-trash-can"></i> Excluir</button></li>
                            </ChildListItems>
                        </DropdownButton>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@(!CanModifyScript)">
                        <i class="fa-solid fa-floppy-disk"></i> Salvar
                    </button>
                </div>
            </div>

            <ValidationSummary />

            <fieldset disabled="@(!CanModifyScript)">
                <div class="row g-3">
                    <div class="col-lg-5">
                        <label class="form-label" for="script-name">Nome</label>
                        <InputText id="script-name" class="form-control" @bind-Value="_selectedScript.Name" placeholder="Ex.: Limpar arquivos temporários" />
                        <ValidationMessage For="() => _selectedScript.Name" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label" for="script-shell">Shell</label>
                        <InputSelect id="script-shell" class="form-select" @bind-Value="_selectedScript.Shell">
                            @foreach (var shell in Enum.GetValues<ScriptingShell>())
                            {
                                <option @key="shell" value="@shell">@EnumLabels.Get(shell)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <label class="form-label" for="script-folder">Pasta</label>
                        <InputText id="script-folder" class="form-control" list="script-folders" @bind-Value="_selectedScript.FolderPath" placeholder="Ex.: manutencao/windows" />
                        <datalist id="script-folders">
                            @foreach (var folder in ParentPage.KnownFolders)
                            {
                                <option value="@folder"></option>
                            }
                        </datalist>
                        <ValidationMessage For="() => _selectedScript.FolderPath" />
                    </div>
                </div>

                <div class="editor-switches">
                    <label class="switch-card">
                        <div class="form-check form-switch m-0">
                            <InputCheckbox class="form-check-input" role="switch" @bind-Value="_selectedScript.IsPublic" />
                        </div>
                        <span><strong>Público</strong><small>Outros usuários da organização podem ver e executar.</small></span>
                    </label>
                    <label class="switch-card">
                        <div class="form-check form-switch m-0">
                            <InputCheckbox class="form-check-input" role="switch" @bind-Value="_selectedScript.IsQuickScript" />
                        </div>
                        <span><strong>Script rápido</strong><small>Aparece em "Scripts rápidos" no terminal da tela de dispositivos.</small></span>
                    </label>
                </div>

                <div class="code-editor">
                    <div class="code-editor-bar">
                        <span class="shell-tag shell-@_selectedScript.Shell.ToString().ToLowerInvariant()">@EnumLabels.Get(_selectedScript.Shell)</span>
                        <span class="ms-auto">@LineCount linha(s)</span>
                    </div>
                    <InputTextArea @bind-Value="_selectedScript.Content"
                                   class="code-editor-input"
                                   spellcheck="false"
                                   autocomplete="off"
                                   rows="16"
                                   placeholder="@GetPlaceholder()" />
                </div>
                <ValidationMessage For="() => _selectedScript.Content" />

                <details class="editor-section">
                    <summary><i class="fa-regular fa-bell"></i> Alertas quando o script der erro</summary>
                    <div class="editor-section-body">
                        <p class="form-text mt-0">
                            Conta como erro qualquer saída de erro. No CMD, Windows PowerShell e Bash, código de saída diferente de 0 também.
                            No PowerShell 7, use <code>Write-Error</code> ou <code>Write-Warning</code>.
                        </p>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <InputCheckbox id="alert-on-error" class="form-check-input" role="switch" @bind-Value="_selectedScript.GenerateAlertOnError" />
                                    <label class="form-check-label" for="alert-on-error">Gerar alerta no painel</label>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox id="email-on-error" class="form-check-input" role="switch" @bind-Value="_selectedScript.SendEmailOnError" />
                                    <label class="form-check-label" for="email-on-error">Enviar e-mail</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="error-email">E-mail para avisos</label>
                                <InputText id="error-email" type="email" class="form-control" disabled="@(!_selectedScript.SendEmailOnError)"
                                           @bind-Value="_selectedScript.SendErrorEmailTo" placeholder="ti@empresa.com.br" />
                                <ValidationMessage For="() => _selectedScript.SendErrorEmailTo" />
                            </div>
                        </div>
                    </div>
                </details>

                <details class="editor-section">
                    <summary><i class="fa-solid fa-code"></i> Variáveis de ambiente disponíveis</summary>
                    <div class="editor-section-body">
                        <dl class="detail-list">
                            <dt><code>DeviceId</code></dt>
                            <dd>ID do computador que está executando o script.</dd>
                            <dt><code>ServerUrl</code></dt>
                            <dd>Endereço do servidor Remotely ao qual o agente está conectado.</dd>
                        </dl>
                        <p class="form-text mb-0">
                            No PowerShell: <code>$env:DeviceId</code> · no CMD: <code>%DeviceId%</code> · no Bash: <code>$DeviceId</code>
                        </p>
                    </div>
                </details>
            </fieldset>
        </EditForm>
    </section>
</div>
