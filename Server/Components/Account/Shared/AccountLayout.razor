@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IDataService DataService

@*
    Layout das telas públicas de conta (entrar, cadastrar, recuperar senha...).
    As telas de "Minha conta" usam o ManageLayout, que fica dentro do layout principal.
*@

@if (HttpContext is null)
{
    <p class="p-4">Carregando...</p>
}
else
{
    <div class="auth-shell">
        <section class="auth-aside">
            <div class="auth-brand">
                <span class="brand-mark"><i class="fa-solid fa-display"></i></span>
                <span>@_brandName</span>
            </div>

            <div>
                <h2>Suporte remoto rápido, seguro e no seu servidor.</h2>
                <p>Acesse os computadores da sua equipe, execute scripts e acompanhe tudo em um só lugar.</p>

                <div class="auth-downloads">
                    <div class="auth-downloads-head">
                        <strong><i class="fa-solid fa-headset"></i> Precisa de suporte agora?</strong>
                        <span>Baixe o cliente, abra e informe o código ao técnico. Não precisa instalar.</span>
                    </div>
                    <div class="auth-downloads-grid">
                        <a class="auth-download" href="@GetDownloadUrl("WindowsDesktop-x64")" target="_blank">
                            <i class="fa-brands fa-windows"></i>
                            <span><strong>Windows</strong><small>64 bits</small></span>
                        </a>
                        <a class="auth-download" href="@GetDownloadUrl("WindowsDesktop-x86")" target="_blank">
                            <i class="fa-brands fa-windows"></i>
                            <span><strong>Windows</strong><small>32 bits</small></span>
                        </a>
                        <a class="auth-download" href="@GetDownloadUrl("UbuntuDesktop")" target="_blank">
                            <i class="fa-brands fa-linux"></i>
                            <span><strong>Linux</strong><small>64 bits</small></span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="auth-footer-links">
                <a href="/Viewer" target="_blank"><i class="fa-solid fa-desktop"></i> Entrar em uma sessão</a>
                <a href="downloads"><i class="fa-solid fa-download"></i> Todos os downloads</a>
                <a href="about"><i class="fa-solid fa-circle-info"></i> Sobre</a>
                <span class="auth-credit">Remotely · mantido por Michael Rodrigues</span>
            </div>
        </section>

        <main class="auth-main">
            <div class="auth-card">
                <div class="auth-mobile-brand">
                    <div class="auth-brand">
                        <span class="brand-mark"><i class="fa-solid fa-display"></i></span>
                        <span>@_brandName</span>
                    </div>
                </div>
                @Body
            </div>
        </main>
    </div>
}

@code {
    private string _brandName = "Remotely";
    private string? _organizationId;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string GetDownloadUrl(string platform)
    {
        return string.IsNullOrWhiteSpace(_organizationId)
            ? $"/api/ClientDownloads/Desktop/{platform}"
            : $"/api/ClientDownloads/Desktop/{platform}/{_organizationId}";
    }

    protected override async Task OnInitializedAsync()
    {
        var orgResult = await DataService.GetDefaultOrganization();
        if (orgResult.IsSuccess)
        {
            _organizationId = orgResult.Value.ID;
            if (!string.IsNullOrWhiteSpace(orgResult.Value.OrganizationName))
            {
                _brandName = orgResult.Value.OrganizationName;
            }
        }
        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            // Rodando em modo interativo: as telas de identidade precisam de HttpContext
            // (cookies), então voltamos para renderização no servidor.
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
