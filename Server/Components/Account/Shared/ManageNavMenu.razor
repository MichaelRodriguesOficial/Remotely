@using Microsoft.AspNetCore.Identity
@using Remotely.Server.Data

@inject SignInManager<RemotelyUser> SignInManager

<nav class="settings-nav" aria-label="Minha conta">
    <NavLink class="nav-link" href="Account/Manage" Match="NavLinkMatch.All"><i class="fa-solid fa-id-card"></i> Perfil</NavLink>
    <NavLink class="nav-link" href="Account/Manage/Email"><i class="fa-solid fa-envelope"></i> E-mail</NavLink>
    <NavLink class="nav-link" href="Account/Manage/ChangePassword"><i class="fa-solid fa-lock"></i> Senha</NavLink>
    @if (hasExternalLogins)
    {
    <NavLink class="nav-link" href="Account/Manage/ExternalLogins"><i class="fa-solid fa-link"></i> Logins externos</NavLink>
    }
    <NavLink class="nav-link" href="Account/Manage/TwoFactorAuthentication"><i class="fa-solid fa-shield-halved"></i> Verificação em duas etapas</NavLink>
    <NavLink class="nav-link" href="Account/Manage/PersonalData"><i class="fa-solid fa-database"></i> Dados pessoais</NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
