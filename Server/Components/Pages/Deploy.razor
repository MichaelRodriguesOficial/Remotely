@page "/deploy"
@using Microsoft.Extensions.FileProviders
@using System.Diagnostics
@attribute [Authorize]
@inject NavigationManager NavMan
@inject IAuthService Auth
@inject IDataService DataService
@inject IJsInterop JsInterop
@inject IToastService Toasts
@inject IWebHostEnvironment HostEnv
@inject ILogger<Deploy> Logger

@if (_isLoading)
{
    <LoadingSignal StatusMessage="@_loadingMessage" />
}

<PageHeader Title="Implantar agente"
            Subtitle="Copie o comando e execute no computador que você quer gerenciar."
            Icon="fa-solid fa-rocket" />

<h2 class="section-title mt-0">Instalação em um comando</h2>
<div class="d-grid gap-3 mb-2">
    <div class="platform-card">
        <div class="platform-card-head">
            <span class="os-icon windows"><i class="fa-brands fa-windows"></i></span>
            <div><strong>Windows 10 e 11</strong><span>PowerShell como administrador · 32 e 64 bits</span></div>
        </div>
        <div class="code-block">@_windowsScript<button class="btn btn-sm btn-secondary btn-icon copy" title="Copiar" @onclick="() => CopyScriptToClipboard(_windowsScript)"><i class="fa-regular fa-copy"></i></button></div>
    </div>
    <div class="platform-card">
        <div class="platform-card-head">
            <span class="os-icon linux"><i class="fa-brands fa-ubuntu"></i></span>
            <div><strong>Ubuntu</strong><span>Terminal · 64 bits</span></div>
        </div>
        <div class="code-block">@_ubuntuScript<button class="btn btn-sm btn-secondary btn-icon copy" title="Copiar" @onclick="() => CopyScriptToClipboard(_ubuntuScript)"><i class="fa-regular fa-copy"></i></button></div>
    </div>
    <div class="platform-card">
        <div class="platform-card-head">
            <span class="os-icon linux"><i class="fa-brands fa-linux"></i></span>
            <div><strong>Manjaro</strong><span>Terminal · 64 bits</span></div>
        </div>
        <div class="code-block">@_manjaroScript<button class="btn btn-sm btn-secondary btn-icon copy" title="Copiar" @onclick="() => CopyScriptToClipboard(_manjaroScript)"><i class="fa-regular fa-copy"></i></button></div>
    </div>
</div>
<p class="form-text">O agente se conecta a este servidor e entra automaticamente na sua organização.</p>

<h2 class="section-title">Cliente de suporte assistido personalizado</h2>
<div class="alert alert-info">
    <i class="fa-solid fa-circle-info me-1"></i>
    Você pode enviar uma versão própria do <code>Remotely_Desktop.exe</code> (por exemplo, assinada com um certificado
    para evitar o aviso do SmartScreen) e mandar o link para os usuários. Os arquivos ficam em <code>AppData</code>,
    então continuam lá depois de atualizar o servidor ou a imagem Docker.
</div>
<div class="row g-3">
    <div class="col-xl-6">
    <div class="panel">
        <div class="panel-header">
            <div>
                <h3 class="panel-title"><i class="fa-brands fa-windows"></i> Windows 64 bits</h3>
                <p class="panel-description">Remotely_Desktop.exe para x64</p>
            </div>
            @if (_winX64File?.Exists == true)
            {
                <span class="pill success" title="Enviado em @(_winX64CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))">Personalizado</span>
            }
            else
            {
                <span class="pill">Padrão</span>
            }
        </div>
        <label class="form-label">Link para enviar aos usuários</label>
        <div class="code-block mb-3">@_winX64Uri<button class="btn btn-sm btn-secondary btn-icon copy" title="Copiar link" @onclick="() => CopyUriToClipboard(_winX64Uri)"><i class="fa-regular fa-copy"></i></button></div>
        @if (_isServerAdmin)
        {
            <FileInputButton ClassNames="btn btn-secondary btn-sm" OnChanged="HandleWin64FileChanged">
                <ButtonContent>
                    <i class="fa-solid fa-upload"></i> Enviar binário personalizado
                </ButtonContent>
            </FileInputButton>
        }
    </div>
    </div>
    <div class="col-xl-6">
    <div class="panel">
        <div class="panel-header">
            <div>
                <h3 class="panel-title"><i class="fa-brands fa-windows"></i> Windows 32 bits</h3>
                <p class="panel-description">Remotely_Desktop.exe para x86</p>
            </div>
            @if (_winX86File?.Exists == true)
            {
                <span class="pill success" title="Enviado em @(_winX86CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))">Personalizado</span>
            }
            else
            {
                <span class="pill">Padrão</span>
            }
        </div>
        <label class="form-label">Link para enviar aos usuários</label>
        <div class="code-block mb-3">@_winX86Uri<button class="btn btn-sm btn-secondary btn-icon copy" title="Copiar link" @onclick="() => CopyUriToClipboard(_winX86Uri)"><i class="fa-regular fa-copy"></i></button></div>
        @if (_isServerAdmin)
        {
            <FileInputButton ClassNames="btn btn-secondary btn-sm" OnChanged="HandleWin86FileChanged">
                <ButtonContent>
                    <i class="fa-solid fa-upload"></i> Enviar binário personalizado
                </ButtonContent>
            </FileInputButton>
        }
    </div>
    </div>
</div>
@if (_isServerAdmin)
{
    <p class="form-text mt-2">Somente administradores do servidor podem enviar binários.</p>
}

@code {
    private static readonly SemaphoreSlim _writeLock = new(1, 1);
    private string _organizationId = string.Empty;
    private string _windowsScript = string.Empty;
    private string _ubuntuScript = string.Empty;
    private string _manjaroScript = string.Empty;
    private string _appDataDir = string.Empty;
    private IFileInfo? _winX64File;
    private IFileInfo? _winX86File;
    private string _winX64Uri = string.Empty;
    private string _winX86Uri = string.Empty;
    private bool _isLoading = false;
    private string _loadingMessage = string.Empty;
    private bool _isServerAdmin;
    private DateTime _winX64CreatedDate;
    private DateTime _winX86CreatedDate;

    protected override async Task OnInitializedAsync()
    {
        var userResult = await Auth.GetUser();
        if (!userResult.IsSuccess)
        {
            NavMan.NavigateTo("/", false);
            return;
        }

        _isServerAdmin = userResult.Value.IsServerAdmin;
        _organizationId = userResult.Value.OrganizationID;
        _appDataDir = Path.Combine(HostEnv.ContentRootPath, "AppData");
        _winX64Uri = $"{NavMan.BaseUri}api/custom-binaries/win-x64/desktop/{_organizationId}";
        _winX86Uri = $"{NavMan.BaseUri}api/custom-binaries/win-x86/desktop/{_organizationId}";

        SetFileInfos();

        SetScriptContent();

        await base.OnInitializedAsync();
    }

    private async Task CopyScriptToClipboard(string script)
    {
        try
        {
            var result = await JsInterop.SetClipboardText(script);
            if (result)
            {
                Toasts.ShowToast2("Script copiado para a área de transferência", ToastType.Success);
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while copying script to clipboard.");
        }
        Toasts.ShowToast2("Não foi possível copiar para a área de transferência", ToastType.Error);
    }

    private async Task CopyUriToClipboard(string uri)
    {
        try
        {
            var result = await JsInterop.SetClipboardText(uri);
            if (result)
            {
                Toasts.ShowToast2("Link copiado para a área de transferência", ToastType.Success);
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while copying URI to clipboard.");
        }
        Toasts.ShowToast2("Não foi possível copiar para a área de transferência", ToastType.Error);
    }

    private string GetLinuxScript(string platformId)
    {
        return
            $"sudo rm -f /tmp/Install-Remotely.sh && " +
            $"sudo wget -q -O /tmp/Install-Remotely.sh {NavMan.BaseUri}api/ClientDownloads/{platformId}/{_organizationId} && " +
            $"sudo chmod +x /tmp/Install-Remotely.sh && " +
            $"sudo /tmp/Install-Remotely.sh";
    }


    private async Task HandleWin64FileChanged(InputFileChangeEventArgs ev)
    {
        await TrySaveFile(_winX64File, ev);
    }

    private async Task HandleWin86FileChanged(InputFileChangeEventArgs ev)
    {
        await TrySaveFile(_winX86File, ev);
    }

    private void SetFileInfos()
    {
        _winX64File = HostEnv.ContentRootFileProvider.GetFileInfo("AppData/Win-x64/Remotely_Desktop.exe");
        if (_winX64File?.Exists == true && _winX64File?.PhysicalPath is not null)
        {
            var fileInfo = new FileInfo(_winX64File.PhysicalPath);
            _winX64CreatedDate = fileInfo.CreationTimeUtc;
        }

        _winX86File = HostEnv.ContentRootFileProvider.GetFileInfo("AppData/Win-x86/Remotely_Desktop.exe");
        if (_winX86File?.Exists == true && _winX86File?.PhysicalPath is not null)
        {
            var fileInfo = new FileInfo(_winX86File.PhysicalPath);
            _winX86CreatedDate = fileInfo.CreationTimeUtc;
        }
    }

    private void SetScriptContent()
    {
        _windowsScript =
            $"irm '{NavMan.BaseUri}api/ClientDownloads/WindowsInstaller/{_organizationId}'|iex";

        _ubuntuScript = GetLinuxScript("UbuntuInstaller-x64");

        _manjaroScript = GetLinuxScript("ManjaroInstaller-x64");
    }

    private async Task TrySaveFile(IFileInfo? fileInfo, InputFileChangeEventArgs ev)
    {
        // Since this is server-side Blazor, it would be impossible to
        // get to this point without being a server admin.  But we'll add
        // it here to prevent any issues caused by future changes.
        if (!_isServerAdmin)
        {
            return;
        }

        await _writeLock.WaitAsync();
        try
        {
            if (fileInfo?.PhysicalPath is null)
            {
                Toasts.ShowToast2("Não foi possível encontrar a pasta de destino", ToastType.Error);
                return;
            }

            _loadingMessage = "Enviando arquivo";
            _isLoading = true;
            await InvokeAsync(StateHasChanged);

            _ = Directory.CreateDirectory(Path.GetDirectoryName(fileInfo.PhysicalPath)!);
            await using var rs = ev.File.OpenReadStream(500_000_000);
            await using var fs = File.Open(fileInfo.PhysicalPath, FileMode.Create);
            await rs.CopyToAsync(fs);
            Toasts.ShowToast2("Binário personalizado enviado com sucesso", ToastType.Success);
            SetFileInfos();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while uploading custom binary.");
            Toasts.ShowToast2("Falha ao enviar o binário personalizado", ToastType.Error);
        }
        finally
        {
            _writeLock.Release();
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}
