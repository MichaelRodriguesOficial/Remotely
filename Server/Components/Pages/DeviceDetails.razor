@page "/device-details/{deviceId?}/{activeTab?}"

@attribute [Authorize]
@inherits AuthComponentBase


@if (string.IsNullOrWhiteSpace(DeviceId))
{
    <DeviceInventoryList />
}
else if (_isLoading)
{
    <LoadingSignal StatusMessage="Carregando" />
}
else if (_device is null)
{
    <div class="empty-state mt-5">
        <div class="empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <h3>Dispositivo não encontrado</h3>
        <p>Confira o ID informado.</p>
        <a class="btn btn-secondary" href="device-details">Tentar outro ID</a>
    </div>
}
else if (!_userHasAccess)
{
    <div class="empty-state mt-5">
        <div class="empty-icon"><i class="fa-solid fa-lock"></i></div>
        <h3>Sem permissão</h3>
        <p>Você não tem acesso ao grupo deste dispositivo.</p>
    </div>
}
else
{
    <PageHeader Title="@(_device.DeviceName ?? "Dispositivo")"
                Subtitle="@DeviceDisplay.GetOperatingSystem(_device).Name"
                Icon="@GetOsIcon()">
        <Actions>
            @if (_device.IsOnline)
            {
                <span class="pill success">Online</span>
            }
            else
            {
                <span class="pill">Offline</span>
            }
        </Actions>
    </PageHeader>

    <div class="asset-summary">
        @AssetItem("Tipo", _device.DeviceType)
        @AssetItem("Fabricante", _device.Manufacturer)
        @AssetItem("Modelo", _device.Model)
        @AssetItem("Número de série", _device.SerialNumber)
        @AssetItem("Número de inventário", _device.AssetTag)
        @AssetItem("Localização", _device.Location)
    </div>

    <TabControl InitialActiveTab="@(string.IsNullOrWhiteSpace(ActiveTab) ? "device" : ActiveTab)">
        <TabHeaders>
            <TabHeader Name="device" NavigationUri="@($"/device-details/{DeviceId}/device")">
                <i class="fa-solid fa-circle-info me-1"></i> Detalhes
            </TabHeader>
            <TabHeader Name="inventory" NavigationUri="@($"/device-details/{DeviceId}/inventory")">
                <i class="fa-solid fa-boxes-stacked me-1"></i> Inventário
            </TabHeader>
            <TabHeader Name="diagnostics" NavigationUri="@($"/device-details/{DeviceId}/diagnostics")">
                <i class="fa-solid fa-stethoscope me-1"></i> Diagnóstico
            </TabHeader>
            <TabHeader Name="remote-logs" OnActivated="GetRemoteLogs" NavigationUri="@($"/device-details/{DeviceId}/remote-logs")">
                <i class="fa-solid fa-file-lines me-1"></i> Logs do agente
            </TabHeader>
            <TabHeader Name="script-history" OnActivated="GetScriptHistory" NavigationUri="@($"/device-details/{DeviceId}/script-history")">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> Histórico de scripts
            </TabHeader>
        </TabHeaders>

        <TabContents>
            <TabContent Name="device">
                <div class="row g-3">
                    <div class="col-xl-6">
                        <section class="panel h-100">
                            <div class="panel-header">
                                <h2 class="panel-title"><i class="fa-solid fa-computer"></i> Computador</h2>
                            </div>
                            <DeviceComputerInfo Device="_device" Inventory="_inventory" NameFormat="_nameFormat" ShowSensitive="@(User?.IsAdministrator == true)" />
                        </section>
                    </div>
                    <div class="col-xl-6">
                        <section class="panel h-100">
                            <div class="panel-header">
                                <h2 class="panel-title"><i class="fa-solid fa-tag"></i> Identificação</h2>
                            </div>
                            <EditForm Model="_device" OnValidSubmit="HandleValidSubmit" @onkeydown="EditFormKeyDown">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                @if (!string.IsNullOrWhiteSpace(_alertMessage))
                                {
                                    <AlertBanner Message="@_alertMessage" />
                                }

                                <fieldset disabled="@(!Permissions.ManageDevices)" class="border-0 p-0 m-0">
                                <div class="mb-3">
                                    <label class="form-label" for="device-alias">Apelido</label>
                                    <InputText id="device-alias" class="form-control" placeholder="Ex.: Recepção 01" @bind-Value="@_device.Alias" />
                                    <ValidationMessage For="() => _device.Alias" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="device-group">Grupo</label>
                                    <InputSelect id="device-group" @bind-Value="_device.DeviceGroupID" class="form-select">
                                        <option value="">Nenhum</option>
                                        @foreach (var group in _deviceGroups)
                                        {
                                            <option @key="group.ID" value="@group.ID">@group.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => _device.DeviceGroupID" />
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <label class="form-label" for="device-asset">Número de inventário</label>
                                        <InputText id="device-asset" class="form-control" placeholder="Placa de patrimônio" @bind-Value="_device.AssetTag" />
                                        <ValidationMessage For="() => _device.AssetTag" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label" for="device-location">Localização</label>
                                        <InputText id="device-location" class="form-control" placeholder="Ex.: Matriz · 2º andar · TI" @bind-Value="_device.Location" />
                                        <ValidationMessage For="() => _device.Location" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="device-tags">Tags</label>
                                    <InputText id="device-tags" @bind-Value="_device.Tags" class="form-control" placeholder="Separe por vírgula" />
                                    <ValidationMessage For="() => _device.Tags" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="device-notes">Observações</label>
                                    <InputTextArea id="device-notes" @bind-Value="_device.Notes" class="form-control" rows="6"></InputTextArea>
                                    <ValidationMessage For="() => _device.Notes" />
                                </div>
                                @if (Permissions.ManageDevices)
                                {
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
                                    </div>
                                }
                                else
                                {
                                    <p class="form-text mb-0"><i class="fa-solid fa-lock me-1"></i> Seu perfil não permite editar dispositivos.</p>
                                }
                                </fieldset>
                            </EditForm>
                        </section>
                    </div>
                </div>
            </TabContent>

            <TabContent Name="inventory">
                <DeviceInventoryView Inventory="_inventory"
                                     Device="_device"
                                     NameFormat="_nameFormat"
                                     CanRefresh="_device.IsOnline"
                                     IsRefreshing="_isRefreshingInventory"
                                     OnRefresh="RefreshInventory"
                                     ShowSensitive="@(User?.IsAdministrator == true)" />
            </TabContent>

            <TabContent Name="diagnostics">
                <DeviceDiagnosticsView @key="_device.ID" Device="_device" />
            </TabContent>

            <TabContent Name="remote-logs">
                @if (!_device.IsOnline)
                {
                    <div class="empty-state mt-3">
                        <div class="empty-icon"><i class="fa-solid fa-plug-circle-xmark"></i></div>
                        <h3>Dispositivo offline</h3>
                        <p>O dispositivo precisa estar online para enviar os logs do agente.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-primary" @onclick="GetRemoteLogs"><i class="fa-solid fa-rotate"></i> Atualizar</button>
                        <button class="btn btn-outline-danger" @onclick="DeleteLogs"><i class="fa-solid fa-trash-can"></i> Excluir logs</button>
                    </div>

                    @if (_logLines.Any())
                    {
                        <pre class="log-view">@foreach (var line in _logLines){@line}</pre>
                    }
                    else
                    {
                        <LoadingSignal />
                    }
                }
            </TabContent>

            <TabContent Name="script-history">
                <ScriptHistoryView Device="_device" Results="_scriptResults" OnRefresh="GetScriptHistory" />
            </TabContent>
        </TabContents>
    </TabControl>
}

@code {
    private static RenderFragment AssetItem(string label, string? value) => __builder =>
    {
        <div class="asset-item">
            <span class="asset-label">@label</span>
            @if (string.IsNullOrWhiteSpace(value))
            {
                <span class="asset-value empty">Não informado</span>
            }
            else
            {
                <span class="asset-value" title="@value">@value</span>
            }
        </div>
    };
}
