@page "/device-details/{deviceId?}/{activeTab?}"

@attribute [Authorize]
@inherits AuthComponentBase


@if (string.IsNullOrWhiteSpace(DeviceId))
{
    <PageHeader Title="Detalhes do dispositivo"
                Subtitle="Informe o ID de um dispositivo para ver inventário, logs e histórico de scripts."
                Icon="fa-solid fa-circle-info" />

    <div class="panel" style="max-width: 720px">
        <label class="form-label" for="deviceIdInput">ID do dispositivo</label>
        <div class="input-group mb-3">
            <input id="deviceIdInput" type="text" class="form-control mono" placeholder="00000000-0000-0000-0000-000000000000"
                   @bind="_inputDeviceId"
                   @bind:event="oninput"
                   @onkeydown="EvaluateDeviceIdInputKeyDown">
            <button class="btn btn-primary" @onclick="NavigateToDeviceId"><i class="fa-solid fa-arrow-right"></i> Abrir</button>
        </div>
        <p class="form-text mb-1">Atalhos na tela de dispositivos:</p>
        <ul class="form-text mb-0">
            <li>clique com o botão direito em um card fechado;</li>
            <li>ou abra o card e use o botão <i class="fa-solid fa-up-right-from-square"></i> no cabeçalho.</li>
        </ul>
    </div>
}
else if (_isLoading)
{
    <LoadingSignal StatusMessage="Carregando" />
}
else if (_device is null)
{
    <div class="empty-state mt-5">
        <div class="empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <h3>Dispositivo não encontrado</h3>
        <p>Confira o ID informado.</p>
        <a class="btn btn-secondary" href="device-details">Tentar outro ID</a>
    </div>
}
else if (!_userHasAccess)
{
    <div class="empty-state mt-5">
        <div class="empty-icon"><i class="fa-solid fa-lock"></i></div>
        <h3>Sem permissão</h3>
        <p>Você não tem acesso ao grupo deste dispositivo.</p>
    </div>
}
else
{
    <PageHeader Title="@(_device.DeviceName ?? "Dispositivo")"
                Subtitle="@DeviceDisplay.GetOperatingSystem(_device).Name"
                Icon="@GetOsIcon()">
        <Actions>
            @if (_device.IsOnline)
            {
                <span class="pill success">Online</span>
            }
            else
            {
                <span class="pill">Offline</span>
            }
        </Actions>
    </PageHeader>

    <TabControl InitialActiveTab="@(ActiveTab ?? "device")">
        <TabHeaders>
            <TabHeader Name="device" NavigationUri="@($"/device-details/{DeviceId}/device")">
                <i class="fa-solid fa-circle-info me-1"></i> Detalhes
            </TabHeader>
            <TabHeader Name="remote-logs" OnActivated="GetRemoteLogs" NavigationUri="@($"/device-details/{DeviceId}/remote-logs")">
                <i class="fa-solid fa-file-lines me-1"></i> Logs do agente
            </TabHeader>
            <TabHeader Name="script-history" OnActivated="GetScriptHistory" NavigationUri="@($"/device-details/{DeviceId}/script-history")">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> Histórico de scripts
            </TabHeader>
        </TabHeaders>

        <TabContents>
            <TabContent Name="device">
                <div class="row g-3">
                    <div class="col-xl-6">
                        <section class="panel h-100">
                            <div class="panel-header">
                                <h2 class="panel-title"><i class="fa-solid fa-microchip"></i> Inventário</h2>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="ShowAllDisks"><i class="fa-solid fa-hard-drive"></i> Ver discos</button>
                            </div>
                            <dl class="detail-list">
                                <dt>Nome</dt><dd>@_device.DeviceName</dd>
                                <dt>Plataforma</dt><dd>@_device.Platform</dd>
                                <dt>Sistema</dt><dd>@DeviceDisplay.GetOperatingSystem(_device).Name</dd>
                                @if (DeviceDisplay.GetOperatingSystem(_device).Version is { } detailsOsVersion)
                                {
                                    <dt>Versão</dt><dd class="mono">@detailsOsVersion</dd>
                                }
                                <dt>Arquitetura</dt><dd>@_device.OSArchitecture · @_device.ProcessorCount núcleos</dd>
                                <dt>Usuário</dt>
                                <dd>
                                    @{
                                        var (detailsUser, detailsFullName) = DeviceDisplay.GetUser(_device);
                                    }
                                    @if (detailsFullName is not null)
                                    {
                                        @detailsFullName <span class="text-muted">· @detailsUser</span>
                                    }
                                    else
                                    {
                                        @detailsUser
                                    }
                                </dd>
                                <dt>Memória</dt><dd>@(MathHelper.GetFormattedPercent(_device.UsedMemoryPercent)) de @_device.TotalMemory.ToString("N1") GB</dd>
                                <dt>Disco</dt><dd>@(MathHelper.GetFormattedPercent(_device.UsedStoragePercent)) de @_device.TotalStorage.ToString("N1") GB</dd>
                                <dt>Versão do agente</dt><dd>@_device.AgentVersion</dd>
                                <dt>Última conexão</dt><dd>@_device.LastOnline.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                                <dt>IP público</dt><dd class="mono">@_device.PublicIP</dd>
                                <dt>Endereços MAC</dt><dd class="mono">@(string.Join(", ", _device.MacAddresses ?? Array.Empty<string>()))</dd>
                                <dt>ID</dt><dd class="mono small">@_device.ID</dd>
                            </dl>
                        </section>
                    </div>
                    <div class="col-xl-6">
                        <section class="panel h-100">
                            <div class="panel-header">
                                <h2 class="panel-title"><i class="fa-solid fa-tag"></i> Identificação</h2>
                            </div>
                            <EditForm Model="_device" OnValidSubmit="HandleValidSubmit" @onkeydown="EditFormKeyDown">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                @if (!string.IsNullOrWhiteSpace(_alertMessage))
                                {
                                    <AlertBanner Message="@_alertMessage" />
                                }

                                <fieldset disabled="@(!Permissions.ManageDevices)" class="border-0 p-0 m-0">
                                <div class="mb-3">
                                    <label class="form-label" for="device-alias">Apelido</label>
                                    <InputText id="device-alias" class="form-control" placeholder="Ex.: Recepção 01" @bind-Value="@_device.Alias" />
                                    <ValidationMessage For="() => _device.Alias" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="device-group">Grupo</label>
                                    <InputSelect id="device-group" @bind-Value="_device.DeviceGroupID" class="form-select">
                                        <option value="">Nenhum</option>
                                        @foreach (var group in _deviceGroups)
                                        {
                                            <option @key="group.ID" value="@group.ID">@group.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => _device.DeviceGroupID" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="device-tags">Tags</label>
                                    <InputText id="device-tags" @bind-Value="_device.Tags" class="form-control" placeholder="Separe por vírgula" />
                                    <ValidationMessage For="() => _device.Tags" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="device-notes">Observações</label>
                                    <InputTextArea id="device-notes" @bind-Value="_device.Notes" class="form-control" rows="6"></InputTextArea>
                                    <ValidationMessage For="() => _device.Notes" />
                                </div>
                                @if (Permissions.ManageDevices)
                                {
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
                                    </div>
                                }
                                else
                                {
                                    <p class="form-text mb-0"><i class="fa-solid fa-lock me-1"></i> Seu perfil não permite editar dispositivos.</p>
                                }
                                </fieldset>
                            </EditForm>
                        </section>
                    </div>
                </div>
            </TabContent>

            <TabContent Name="remote-logs">
                @if (!_device.IsOnline)
                {
                    <div class="empty-state mt-3">
                        <div class="empty-icon"><i class="fa-solid fa-plug-circle-xmark"></i></div>
                        <h3>Dispositivo offline</h3>
                        <p>O dispositivo precisa estar online para enviar os logs do agente.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-primary" @onclick="GetRemoteLogs"><i class="fa-solid fa-rotate"></i> Atualizar</button>
                        <button class="btn btn-outline-danger" @onclick="DeleteLogs"><i class="fa-solid fa-trash-can"></i> Excluir logs</button>
                    </div>

                    @if (_logLines.Any())
                    {
                        <pre class="log-view">@foreach (var line in _logLines){@line}</pre>
                    }
                    else
                    {
                        <LoadingSignal />
                    }
                }
            </TabContent>

            <TabContent Name="script-history">
                @if (_scriptResults.IsEmpty)
                {
                    <div class="empty-state mt-3">
                        <div class="empty-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                        <h3>Sem histórico</h3>
                        <p>Nenhum script foi executado neste dispositivo.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Shell</th>
                                    <th>Data/hora</th>
                                    <th>Usuário</th>
                                    <th>Duração</th>
                                    <th>Entrada</th>
                                    <th>Saída</th>
                                    <th>Erro</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var scriptResult in _scriptResults)
                                {
                                    <tr>
                                        <td><span class="pill accent no-dot">@scriptResult.Shell</span></td>
                                        <td class="text-nowrap">@scriptResult.TimeStamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@scriptResult.SenderUserName</td>
                                        <td>@scriptResult.RunTime</td>
                                        <td class="mono small">@GetTrimmedText(scriptResult.ScriptInput, 25)</td>
                                        <td class="mono small">@GetTrimmedText(scriptResult.StandardOutput, 25)</td>
                                        <td class="mono small text-danger">@GetTrimmedText(scriptResult.ErrorOutput, 25)</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-secondary" @onclick="() => ShowFullScriptOutput(scriptResult)">Ver completo</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </TabContent>
        </TabContents>
    </TabControl>
}
