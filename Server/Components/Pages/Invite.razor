@page "/invite/{inviteId?}"
@inject IDataService DataService
@inject AuthenticationStateProvider AuthProvider
@inject IToastService Toasts

<h3>Convite para organização</h3>
<hr />

<div class="row">
    <div class="col-sm-12">
        @if (_joinSuccessful)
        {
            <h5>Parabéns!</h5>
            <p class="text-info">
                Você entrou na organização!
            </p>
        }
        else if (string.IsNullOrWhiteSpace(InviteId))
        {
            <div>
                <strong class="text-danger">O ID do convite não foi informado.</strong>
            </div>
        }
        else
        {
            <div>
                <div>
                    <strong class="text-danger">ATENÇÃO: </strong>
                    <p class="text-danger">Você sairá da organização atual e perderá acesso aos agentes dela, a menos que alguém convide você de novo.</p>
                    <p>Tem certeza de que quer sair da organização atual e entrar nesta?</p>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-secondary me-3" onclick="location.assign(location.origin)">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="Confirm">Confirmar</button>
                </div>
            </div>
        }

    </div>
</div>

@code {
    private bool _joinSuccessful;

    [Parameter]
    public string? InviteId { get; init; }

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(InviteId))
        {
            Toasts.ShowToast2("O ID do convite não foi informado.", ToastType.Error);
            return;
        }

        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity is not { IsAuthenticated: true } identity)
        {
            Toasts.ShowToast2("Você precisa estar logado para entrar em uma organização.", ToastType.Error);
            return;
        }

        var result = await DataService.JoinViaInvitation($"{identity.Name}", InviteId);
        if (!result.IsSuccess)
        {
            Toasts.ShowToast2(result.Reason, ToastType.Error);
            return;
        }

        _joinSuccessful = true;
    }
}