@page "/downloads"
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Logging 

@inject IAuthService Auth
@inject IDataService DataService
@inject UserManager<RemotelyUser> UserManager
@inject IWebHostEnvironment HostEnv
@inject NavigationManager NavManager
@inject ILogger<Downloads> Logger 

<PageHeader Title="Downloads"
            Subtitle="Clientes de suporte instantâneo e agentes para instalar nos computadores."
            Icon="fa-solid fa-download">
    <Actions>
        @if (_isAuthenticated)
        {
            <a class="btn btn-primary" href="deploy"><i class="fa-solid fa-rocket"></i> Script de instalação pronto</a>
        }
    </Actions>
</PageHeader>

<h2 class="section-title mt-0">Suporte instantâneo</h2>
<p class="text-muted mb-3">Compartilhamento de tela na hora, sem instalação e sem conta. Ideal para atender um usuário pontual.</p>

<div class="platform-grid mb-4">
    <div class="platform-card">
        <div class="platform-card-head">
            <span class="os-icon windows"><i class="fa-brands fa-windows"></i></span>
            <div><strong>Windows 64 bits</strong><span>Windows 10 e 11</span></div>
        </div>
        <div class="links">
            <a class="btn btn-primary btn-sm" target="_blank" href="/api/ClientDownloads/Desktop/WindowsDesktop-x64/@_organizationId"><i class="fa-solid fa-download"></i> Baixar .exe</a>
        </div>
    </div>
    <div class="platform-card">
        <div class="platform-card-head">
            <span class="os-icon windows"><i class="fa-brands fa-windows"></i></span>
            <div><strong>Windows 32 bits</strong><span>Computadores antigos</span></div>
        </div>
        <div class="links">
            <a class="btn btn-primary btn-sm" target="_blank" href="/api/ClientDownloads/Desktop/WindowsDesktop-x86/@_organizationId"><i class="fa-solid fa-download"></i> Baixar .exe</a>
        </div>
    </div>
    <div class="platform-card">
        <div class="platform-card-head">
            <span class="os-icon linux"><i class="fa-brands fa-linux"></i></span>
            <div><strong>Linux 64 bits</strong><span>Ubuntu e derivados</span></div>
        </div>
        <div class="links">
            <a class="btn btn-primary btn-sm" target="_blank" href="/api/ClientDownloads/Desktop/UbuntuDesktop/@_organizationId"><i class="fa-solid fa-download"></i> Baixar executável</a>
        </div>
    </div>
</div>

<h2 class="section-title">Agentes residentes</h2>
<p class="text-muted mb-3">Ficam em segundo plano para acesso sem acompanhamento, inventário e execução de scripts.</p>

@if (!_isAuthenticated)
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fa-solid fa-lock"></i></div>
        <h3>Entre para baixar os agentes</h3>
        <p>Os instaladores dos agentes são vinculados à sua organização.</p>
        <a class="btn btn-primary" href="Account/Login"><i class="fa-solid fa-right-to-bracket"></i> Entrar</a>
    </div>
}
else
{
    <div class="platform-grid">
        <div class="platform-card">
            <div class="platform-card-head">
                <span class="os-icon windows"><i class="fa-brands fa-windows"></i></span>
                <div><strong>Windows</strong><span>10 e 11 · 64 e 32 bits</span></div>
            </div>
            <div class="links">
                <a class="btn btn-primary btn-sm" target="_blank" href="/API/ClientDownloads/WindowsInstaller/@_organizationId"><i class="fa-solid fa-download"></i> Instalador PowerShell</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/Content/Remotely-Win-x64.zip">Arquivos x64</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/Content/Remotely-Win-x86.zip">Arquivos x86</a>
            </div>
        </div>
        <div class="platform-card">
            <div class="platform-card-head">
                <span class="os-icon linux"><i class="fa-brands fa-ubuntu"></i></span>
                <div><strong>Linux</strong><span>Ubuntu e Manjaro · x64</span></div>
            </div>
            <div class="links">
                <a class="btn btn-primary btn-sm" target="_blank" href="/API/ClientDownloads/UbuntuInstaller-x64/@_organizationId"><i class="fa-solid fa-download"></i> Ubuntu</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/API/ClientDownloads/ManjaroInstaller-x64/@_organizationId">Manjaro</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/Content/Remotely-Linux.zip">Arquivos</a>
            </div>
        </div>
        <div class="platform-card">
            <div class="platform-card-head">
                <span class="os-icon apple"><i class="fa-brands fa-apple"></i></span>
                <div><strong>macOS</strong><span>Intel (x64) e Apple Silicon (arm64)</span></div>
            </div>
            <div class="links">
                <a class="btn btn-primary btn-sm" target="_blank" href="/API/ClientDownloads/MacOSInstaller-arm64/@_organizationId"><i class="fa-solid fa-download"></i> Apple Silicon</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/API/ClientDownloads/MacOSInstaller-x64/@_organizationId">Intel</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/Content/Remotely-MacOS-arm64.zip">Arquivos arm64</a>
                <a class="btn btn-secondary btn-sm" target="_blank" href="/Content/Remotely-MacOS-x64.zip">Arquivos x64</a>
            </div>
        </div>
    </div>

    <h2 class="section-title">Instalação por linha de comando</h2>
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="panel h-100">
                <h3 class="panel-title mb-3"><i class="fa-brands fa-windows"></i> Windows (PowerShell)</h3>
                <label class="form-label">Instalação silenciosa</label>
                <div class="code-block mb-3">powershell.exe -ExecutionPolicy Bypass -F Install-Remotely.ps1 -install -quiet -organizationid "@_organizationId" -serverurl "@ServerUrl"</div>
                <label class="form-label">Instalação a partir de um .zip local</label>
                <div class="code-block mb-3">powershell.exe -ExecutionPolicy Bypass -F Install-Remotely.ps1 -install -quiet -organizationid "@_organizationId" -serverurl "@ServerUrl" -path "C:\caminho\Remotely-Win-x64.zip"</div>
                <label class="form-label">Todas as opções</label>
                <div class="code-block mb-3">powershell.exe -ExecutionPolicy Bypass -F Install-Remotely.ps1 -install -quiet -supportshortcut -organizationid "@_organizationId" -serverurl "@ServerUrl" -devicegroup "Financeiro" -devicealias "Recepção 01" -deviceuuid "&lt;guid&gt;"</div>
                <label class="form-label">Desinstalação silenciosa</label>
                <div class="code-block">powershell.exe -ExecutionPolicy Bypass -F Install-Remotely.ps1 -uninstall -quiet</div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="panel h-100">
                <h3 class="panel-title mb-3"><i class="fa-brands fa-linux"></i> Linux e macOS (Bash)</h3>
                <label class="form-label">Instalação</label>
                <div class="code-block mb-3">sudo ./Install-Ubuntu-x64.sh</div>
                <label class="form-label">Instalação a partir de um .zip local</label>
                <div class="code-block mb-3">sudo ./Install-Ubuntu-x64.sh --path ./Remotely-Linux.zip</div>
                <label class="form-label">Desinstalação</label>
                <div class="code-block mb-3">sudo ./Install-Ubuntu-x64.sh --uninstall</div>
                <p class="form-text mb-0">
                    No macOS use <code>Install-MacOS-arm64.sh</code> ou <code>Install-MacOS-x64.sh</code> com as mesmas opções.
                </p>
            </div>
        </div>
    </div>
}

@code {
    private string? _organizationId;
    private bool _isAuthenticated;

    private string ServerUrl => NavManager.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await Auth.IsAuthenticated();

        if (_isAuthenticated)
        {
            var userResult = await Auth.GetUser();
            if (userResult.IsSuccess)
            {
                _organizationId = userResult.Value.OrganizationID;
            }
        }
        else
        {
            var orgResult = await DataService.GetDefaultOrganization();
            if (orgResult.IsSuccess)
            {
                _organizationId = orgResult.Value.ID;
            }
        }

        await base.OnInitializedAsync();
    }
}