@page "/manage-organization"
@attribute [Authorize(Policy = PolicyNames.OrganizationAdminRequired)]
@inherits AuthComponentBase

<PageHeader Title="Organização"
            Subtitle="Dados da organização, grupos de dispositivos, usuários e convites."
            Icon="fa-solid fa-building" />

@if (_isLoading)
{
    <LoadingSignal StatusMessage="Carregando" />
}
else if (User is not null)
{
    <div class="row g-3">
        <div class="col-xl-6">
            <section class="panel h-100">
                <div class="panel-header">
                    <h2 class="panel-title"><i class="fa-solid fa-building"></i> Dados da organização</h2>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="orgName">Nome</label>
                    <input id="orgName"
                           @onchange="OrganizationNameChanged"
                           value="@_organization?.OrganizationName"
                           maxlength="25"
                           placeholder="Informe o nome da organização"
                           class="form-control"
                           autocomplete="off" />
                    <div class="form-text">Salvo ao sair do campo. Aparece no menu lateral e na tela de login.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">ID da organização</label>
                    <div class="code-block">@_organization?.ID</div>
                    <div class="form-text">Usado nos instaladores dos agentes e na API.</div>
                </div>
                @if (User.IsServerAdmin)
                {
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <div class="fw-600">Organização padrão do servidor</div>
                            <div class="form-text mt-0">Recebe os clientes de suporte baixados sem login.</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-ghost btn-icon btn-sm" title="Ajuda" @onclick="ShowDefaultOrgHelp"><i class="fa-regular fa-circle-question"></i></button>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" aria-label="Organização padrão" checked="@_organization?.IsDefaultOrganization" @onchange="DefaultOrgCheckChanged" />
                            </div>
                        </div>
                    </div>
                }
            </section>
        </div>

        <div class="col-xl-6">
            <section class="panel h-100">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title"><i class="fa-solid fa-layer-group"></i> Grupos de dispositivos</h2>
                        <p class="panel-description">Organize as máquinas e limite o acesso de cada usuário.</p>
                    </div>
                    <button class="btn btn-ghost btn-icon btn-sm" title="Ajuda" @onclick="ShowDeviceGroupHelp"><i class="fa-regular fa-circle-question"></i></button>
                </div>
                <div class="input-group mb-3">
                    <input placeholder="Nome do novo grupo" class="form-control" maxlength="200"
                           @bind="_newDeviceGroupName"
                           @bind:event="oninput"
                           @onkeypress="EvaluateNewDeviceGroupKeyPress" />
                    <button type="button" class="btn btn-primary" @onclick="CreateNewDeviceGroup"><i class="fa-solid fa-plus"></i> Adicionar</button>
                </div>
                <div class="list-editor">
                    @if (_deviceGroups.Count == 0)
                    {
                        <div class="list-empty">Nenhum grupo criado.</div>
                    }
                    @foreach (var deviceGroup in _deviceGroups)
                    {
                        <div class="list-item" @key="deviceGroup.ID">
                            <span><i class="fa-solid fa-folder me-2 text-muted"></i>@deviceGroup.Name</span>
                            <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Excluir grupo"
                                    @onclick="() => DeleteDeviceGroup(deviceGroup.ID)">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    <section class="panel mt-3">
        <div class="panel-header">
            <div>
                <h2 class="panel-title"><i class="fa-solid fa-users"></i> Usuários</h2>
                <p class="panel-description">@_orgUsers.Count usuário(s) na organização.</p>
            </div>
            <button class="btn btn-ghost btn-icon btn-sm" title="Ajuda" @onclick="ShowUsersHelp"><i class="fa-regular fa-circle-question"></i></button>
        </div>
        <div class="table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Usuário</th>
                        <th>Administrador</th>
                        <th>Perfil de acesso</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var orgUser in _orgUsers)
                    {
                        var isSelf = User.Id == orgUser.Id;
                        <tr @key="orgUser.Id">
                            <td>
                                <span class="fw-600">@orgUser.UserName</span>
                                @if (isSelf)
                                {
                                    <span class="pill accent no-dot ms-2">você</span>
                                }
                            </td>
                            <td>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           aria-label="Administrador"
                                           disabled="@isSelf"
                                           checked="@orgUser.IsAdministrator"
                                           @onchange="(ev) => SetUserIsAdmin(ev, orgUser)" />
                                </div>
                            </td>
                            <td>
                                @if (orgUser.IsAdministrator)
                                {
                                    <span class="text-muted small">Acesso total (administrador)</span>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm profile-select" aria-label="Perfil de @orgUser.UserName"
                                            value="@(GetUserProfileId(orgUser) ?? string.Empty)"
                                            @onchange="(ev) => ChangeUserProfile(orgUser, ev)">
                                        <option value="">Sem perfil (acesso total)</option>
                                        @foreach (var profile in _profiles)
                                        {
                                            <option @key="profile.Id" value="@profile.Id">@profile.Name</option>
                                        }
                                    </select>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-secondary" @onclick="() => EditDeviceGroups(orgUser)"><i class="fa-solid fa-layer-group"></i> Grupos</button>
                                @if (!isSelf)
                                {
                                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => ResetPassword(orgUser)"><i class="fa-solid fa-key"></i> Redefinir senha</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Excluir usuário" @onclick="() => DeleteUser(orgUser)"><i class="fa-solid fa-trash-can"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel mt-3" id="perfis">
        <div class="panel-header">
            <div>
                <h2 class="panel-title"><i class="fa-solid fa-id-badge"></i> Perfis de acesso</h2>
                <p class="panel-description">
                    Defina o que cada tipo de usuário pode fazer e quais grupos ele enxerga. Administradores sempre têm acesso total.
                </p>
            </div>
            @if (_editingProfile is null)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="NewProfile"><i class="fa-solid fa-plus"></i> Novo perfil</button>
            }
        </div>

        @if (_editingProfile is not null)
        {
            <div class="profile-editor">
                <div class="row g-3">
                    <div class="col-lg-5">
                        <label class="form-label" for="profile-name">Nome</label>
                        <input id="profile-name" class="form-control" maxlength="60" placeholder="Ex.: Técnico N1"
                               @bind="_editingProfile.Name" @bind:event="oninput" />
                    </div>
                    <div class="col-lg-7">
                        <label class="form-label" for="profile-description">Descrição <span class="text-muted fw-normal">(opcional)</span></label>
                        <input id="profile-description" class="form-control" maxlength="200" placeholder="Ex.: Atendimento ao usuário, sem scripts"
                               @bind="_editingProfile.Description" @bind:event="oninput" />
                    </div>
                </div>

                <h3 class="profile-subtitle">O que este perfil pode fazer</h3>
                <div class="profile-permissions">
                    <label class="permission-card">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="_editingProfile.AllowRemoteControl" />
                        </div>
                        <span>
                            <strong><i class="fa-solid fa-desktop"></i> Acesso remoto</strong>
                            <small>Controle remoto, somente visualizar e chat.</small>
                        </span>
                    </label>
                    <label class="permission-card">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="_editingProfile.AllowScripts" />
                        </div>
                        <span>
                            <strong><i class="fa-solid fa-terminal"></i> Scripts e terminal</strong>
                            <small>Terminal, executar, criar e agendar scripts.</small>
                        </span>
                    </label>
                    <label class="permission-card">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" @bind="_editingProfile.AllowDeviceManagement" />
                        </div>
                        <span>
                            <strong><i class="fa-solid fa-screwdriver-wrench"></i> Gerenciar dispositivos</strong>
                            <small>Editar apelido, grupo e observações, enviar arquivos, ligar (WoL) e desinstalar o agente.</small>
                        </span>
                    </label>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-lg-6">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h3 class="profile-subtitle m-0">Grupos visíveis</h3>
                            <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                <input id="profile-restrict" class="form-check-input" type="checkbox" role="switch" @bind="_editingProfile.RestrictToGroups" />
                                <label class="form-check-label small m-0" for="profile-restrict">Só os grupos escolhidos</label>
                            </div>
                        </div>
                        @if (_editingProfile.RestrictToGroups)
                        {
                            <div class="list-editor profile-list">
                                @if (_deviceGroups.Count == 0)
                                {
                                    <div class="list-empty">Crie grupos de dispositivos acima para usar aqui.</div>
                                }
                                @foreach (var group in _deviceGroups)
                                {
                                    <label class="list-item check-row" @key="group.ID">
                                        <span><i class="fa-solid fa-folder me-2 text-warning"></i>@group.Name</span>
                                        <input class="form-check-input" type="checkbox"
                                               checked="@_editingProfile.DeviceGroupIds.Contains(group.ID)"
                                               @onchange="(ev) => ToggleProfileGroup(group.ID, ev)" />
                                    </label>
                                }
                            </div>
                            <p class="form-text">Os usuários do perfil passam a ver só os dispositivos desses grupos.</p>
                        }
                        else
                        {
                            <p class="form-text mt-0">Desligado: cada usuário continua com os grupos definidos no botão "Grupos" da tabela de usuários.</p>
                        }
                    </div>
                    <div class="col-lg-6">
                        <h3 class="profile-subtitle mb-2">Usuários neste perfil</h3>
                        <div class="list-editor profile-list">
                            @{
                                var members = _orgUsers.Where(x => !x.IsAdministrator).ToList();
                            }
                            @if (members.Count == 0)
                            {
                                <div class="list-empty">Nenhum usuário (não administrador) na organização ainda.</div>
                            }
                            @foreach (var member in members)
                            {
                                var otherProfile = _profiles.FirstOrDefault(x => x.Id != _editingProfile.Id && x.UserIds.Contains(member.Id));
                                <label class="list-item check-row" @key="member.Id">
                                    <span class="truncate">
                                        @member.UserName
                                        @if (otherProfile is not null && !_editingProfile.UserIds.Contains(member.Id))
                                        {
                                            <span class="text-muted small ms-1">(hoje: @otherProfile.Name)</span>
                                        }
                                    </span>
                                    <input class="form-check-input" type="checkbox"
                                           checked="@_editingProfile.UserIds.Contains(member.Id)"
                                           @onchange="(ev) => ToggleProfileUser(member.Id, ev)" />
                                </label>
                            }
                        </div>
                        <p class="form-text">Cada usuário fica em um perfil só; marcar aqui tira ele do perfil anterior.</p>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-ghost" @onclick="CancelProfileEdit">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveProfile">
                        <i class="fa-solid fa-floppy-disk"></i> @(_isNewProfile ? "Criar perfil" : "Salvar perfil")
                    </button>
                </div>
            </div>
        }
        else if (_profiles.Count == 0)
        {
            <div class="profile-empty">
                <i class="fa-solid fa-id-badge"></i>
                <div>
                    <strong>Nenhum perfil criado</strong>
                    <p>Sem perfil, cada usuário pode fazer tudo nos grupos a que tem acesso. Crie perfis como "Técnico N1" ou "Somente consulta" para limitar.</p>
                </div>
            </div>
        }
        else
        {
            <div class="profile-grid">
                @foreach (var profile in _profiles)
                {
                    <article class="profile-card" @key="profile.Id">
                        <div class="profile-card-head">
                            <div class="min-w-0">
                                <strong class="truncate d-block">@profile.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(profile.Description))
                                {
                                    <span class="text-muted small">@profile.Description</span>
                                }
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Editar" @onclick="() => EditProfile(profile)"><i class="fa-solid fa-pen"></i></button>
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Excluir" @onclick="() => DeleteProfile(profile)"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>
                        <div class="profile-perms">
                            <span class="pill @(profile.AllowRemoteControl ? "success" : "")"><i class="fa-solid @(profile.AllowRemoteControl ? "fa-check" : "fa-xmark")"></i> Acesso remoto</span>
                            <span class="pill @(profile.AllowScripts ? "success" : "")"><i class="fa-solid @(profile.AllowScripts ? "fa-check" : "fa-xmark")"></i> Scripts</span>
                            <span class="pill @(profile.AllowDeviceManagement ? "success" : "")"><i class="fa-solid @(profile.AllowDeviceManagement ? "fa-check" : "fa-xmark")"></i> Gerenciar</span>
                        </div>
                        <dl class="profile-meta">
                            <dt>Grupos</dt>
                            <dd>
                                @if (!profile.RestrictToGroups)
                                {
                                    <span class="text-muted">Definidos por usuário</span>
                                }
                                else
                                {
                                    @string.Join(", ", profile.DeviceGroupIds.Select(GetGroupName))
                                }
                            </dd>
                            <dt>Usuários</dt>
                            <dd>@(profile.UserIds.Count == 0 ? "Nenhum" : $"{profile.UserIds.Count}")</dd>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel mt-3">
        <div class="panel-header">
            <div>
                <h2 class="panel-title"><i class="fa-solid fa-envelope-open-text"></i> Convidar usuário</h2>
                <p class="panel-description">Se o e-mail já tiver conta, o usuário entra direto; senão recebe um link de convite.</p>
            </div>
            <button class="btn btn-ghost btn-icon btn-sm" title="Ajuda" @onclick="ShowInvitesHelp"><i class="fa-regular fa-circle-question"></i></button>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <div class="input-icon flex-grow-1" style="min-width: 240px">
                <i class="fa-regular fa-envelope"></i>
                <input @bind="_inviteEmail" @bind:event="oninput"
                       @onkeypress="EvaluateInviteInputKeypress"
                       placeholder="email@empresa.com.br"
                       type="email"
                       class="form-control" />
            </div>
            <label class="check-chip">
                <input class="form-check-input" @bind="_inviteAsAdmin" type="checkbox" /> Administrador
            </label>
            <button type="button" class="btn btn-primary" @onclick="SendInvite"><i class="fa-solid fa-paper-plane"></i> Convidar</button>
        </div>

        @if (_invites.Count > 0)
        {
            <div class="table-wrap">
                <table id="invitesTable" class="table table-hover">
                    <thead>
                        <tr>
                            <th>Convite pendente</th>
                            <th>Administrador</th>
                            <th>Link</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in _invites)
                        {
                            <tr @key="invite.ID">
                                <td>@invite.InvitedUser</td>
                                <td>@(invite.IsAdmin ? "Sim" : "Não")</td>
                                <td><a href="@(NavManager.BaseUri)Invite/@invite.ID" target="_blank">Abrir link de convite</a></td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" title="Excluir convite" invite="@invite.ID" @onclick="() => DeleteInvite(invite)"><i class="fa-solid fa-trash-can"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
