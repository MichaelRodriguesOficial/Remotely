@page "/user-options"
@attribute [Authorize]
@inherits AuthComponentBase

@inject AuthenticationStateProvider AuthProvider
@inject UserManager<RemotelyUser> UserManager
@inject IDataService DataService
@inject IToastService ToastService
@inject IModalService ModalService

<PageHeader Title="Preferências"
            Subtitle="Ajustes pessoais da sua conta neste painel."
            Icon="fa-solid fa-gear" />

<EditForm Model="_options" OnValidSubmit="HandleValidSubmit" @onkeydown="EditFormKeyDown" style="max-width: 880px">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(_alertMessage))
    {
        <AlertBanner Message="@_alertMessage" />
    }

    <section class="panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title"><i class="fa-regular fa-user"></i> Perfil e aparência</h2>
            </div>
        </div>
        <div class="setting-row">
            <div>
                <p class="setting-label">Seu nome</p>
                <p class="setting-desc">Exibido para quem você atende, no lugar do seu e-mail.</p>
            </div>
            <div class="setting-control">
                <InputText @bind-Value="_options.DisplayName" class="form-control" placeholder="Ex.: Michael (TI)" />
            </div>
        </div>
        <ValidationMessage For="() => _options.DisplayName" />
        <div class="setting-row">
            <div>
                <p class="setting-label">Tema</p>
                <p class="setting-desc">Escuro ou claro. Aplicado ao recarregar a página.</p>
            </div>
            <div class="setting-control">
                <InputSelect @bind-Value="_options.Theme" class="form-select">
                    @foreach (var setting in Enum.GetValues(typeof(Theme)))
                    {
                        <option @key="setting" value="@setting">@EnumLabels.Get(setting)</option>
                    }
                </InputSelect>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <h2 class="panel-title"><i class="fa-solid fa-terminal"></i> Atalhos do terminal</h2>
                <p class="panel-description">Digite o atalho no terminal para trocar de shell rapidamente.</p>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="ShowShortcutHelp">
                <i class="fa-regular fa-circle-question"></i> Ajuda
            </button>
        </div>
                <div class="setting-row">
                    <div>
                        <p class="setting-label">PowerShell Core</p>
                        <p class="setting-desc">pwsh 7+ no Windows, Linux e macOS.</p>
                    </div>
                    <div class="setting-control">
                        <InputText @bind-Value="_options.CommandModeShortcutPSCore" class="form-control mono" />
                    </div>
                </div>
                <div class="setting-row">
                    <div>
                        <p class="setting-label">Windows PowerShell</p>
                        <p class="setting-desc">powershell.exe 5.1 (somente Windows).</p>
                    </div>
                    <div class="setting-control">
                        <InputText @bind-Value="_options.CommandModeShortcutWinPS" class="form-control mono" />
                    </div>
                </div>
                <div class="setting-row">
                    <div>
                        <p class="setting-label">CMD</p>
                        <p class="setting-desc">Prompt de comando do Windows.</p>
                    </div>
                    <div class="setting-control">
                        <InputText @bind-Value="_options.CommandModeShortcutCMD" class="form-control mono" />
                    </div>
                </div>
                <div class="setting-row">
                    <div>
                        <p class="setting-label">Bash</p>
                        <p class="setting-desc">Linux e macOS.</p>
                    </div>
                    <div class="setting-control">
                        <InputText @bind-Value="_options.CommandModeShortcutBash" class="form-control mono" />
                    </div>
                </div>
    </section>

    <div class="save-bar">
        <span><i class="fa-regular fa-floppy-disk me-1"></i> As alterações valem só para a sua conta.</span>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Salvar</button>
    </div>
</EditForm>

@code {
    private RemotelyUserOptions _options = new();
    private string? _alertMessage;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _options = User?.UserOptions ?? new();
    }

    private Task HandleValidSubmit()
    {
        EnsureUserSet();

        if (!_options.CommandModeShortcutBash.StartsWith("/"))
        {
            _options.CommandModeShortcutBash = "/" + _options.CommandModeShortcutBash;
        }
        if (!_options.CommandModeShortcutCMD.StartsWith("/"))
        {
            _options.CommandModeShortcutCMD = "/" + _options.CommandModeShortcutCMD;
        }
        if (!_options.CommandModeShortcutPSCore.StartsWith("/"))
        {
            _options.CommandModeShortcutPSCore = "/" + _options.CommandModeShortcutPSCore;
        }
        if (!_options.CommandModeShortcutWinPS.StartsWith("/"))
        {
            _options.CommandModeShortcutWinPS = "/" + _options.CommandModeShortcutWinPS;
        }

        DataService.UpdateUserOptions(UserName, _options);

        _alertMessage = "Preferências salvas";

        ToastService.ShowToast("Preferências salvas.");

        return Task.CompletedTask;
    }

    private void EditFormKeyDown()
    {
        _alertMessage = "";
    }

    private void ShowShortcutHelp()
    {
        var modalText = "Os atalhos de shell servem para trocar rapidamente de shell no terminal da página inicial. " +
            "Ao digitar um desses atalhos no terminal, o modo de comando correspondente é selecionado " +
            "(ex.: PowerShell Core, Bash etc.).";

        ModalService.ShowModal("Atalhos de shell", new[] { modalText });
    }
}
