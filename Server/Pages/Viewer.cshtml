@page
@using Remotely.Server.Pages
@model ViewerModel
@inject IWebHostEnvironment HostEnvironment

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.9, user-scalable=no" />
    <title>@(Model.PageTitle)</title>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content="@(Model.PageDescription)" />
    <link href="/manifest.json" rel="manifest" />
    <link rel="icon" href="@(Model.FaviconUrl)" />
    <link href="/css/remote-control.css" rel="stylesheet" asp-append-version="true" />

    @if (!string.IsNullOrWhiteSpace(Model.ThemeUrl))
    {
        <link href="@(Model.ThemeUrl)" rel="stylesheet" asp-append-version="true" />
    }

    <link href="/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="/lib/fontawesome/css/brands.min.css" rel="stylesheet" />
    <link href="/css/viewer-modern.css" rel="stylesheet" asp-append-version="true" />

    <environment include="Development">
        <script src="/lib/microsoft-signalr/signalr.js"></script>
        <script src="/lib/microsoft/signalr-protocol-msgpack/dist/browser/signalr-protocol-msgpack.js"></script>
        <script src="/lib/msgpack/dist.es5+umd/msgpack.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="/lib/microsoft-signalr/signalr.min.js"></script>
        <script src="/lib/microsoft/signalr-protocol-msgpack/dist/browser/signalr-protocol-msgpack.min.js"></script>
        <script src="/lib/msgpack/dist.es5+umd/msgpack.min.js"></script>
    </environment>
</head>
<body>
    <div id="backgroundLayers" class="background-layers">
        <div class="background-layer-1"></div>
        <div class="background-layer-2"></div>
        <div class="background-layer-3"></div>
    </div>

    <div id="screenSelectMenu" class="popup-menu">
    </div>

    <div id="clipboardTransferMenu" class="popup-menu">
        <button id="sendClipboardButton" class="d-none"></button>
    </div>

    <div id="shortcutsMenu" class="popup-menu">
        <button id="ctrlAltDelButton" class="d-none" title="Tela de segurança do Windows (bloquear, trocar usuário, Gerenciador de Tarefas).">
            <i class="fas fa-shield-halved"></i> Ctrl+Alt+Del
        </button>
        <button data-keys="Meta" title="Abre o menu Iniciar."><i class="fa-brands fa-windows"></i> Menu Iniciar <kbd>Win</kbd></button>
        <button data-keys="Meta+r" title="Abre o Executar."><i class="fas fa-terminal"></i> Executar <kbd>Win+R</kbd></button>
        <button data-keys="Meta+e" title="Abre o Explorador de Arquivos."><i class="fas fa-folder-open"></i> Explorador <kbd>Win+E</kbd></button>
        <button data-keys="Meta+d" title="Mostra a Área de Trabalho."><i class="fas fa-display"></i> Área de Trabalho <kbd>Win+D</kbd></button>
        <button data-keys="Control+Shift+Escape" title="Abre o Gerenciador de Tarefas."><i class="fas fa-list-check"></i> Gerenciador de Tarefas <kbd>Ctrl+Shift+Esc</kbd></button>
        <button data-keys="Alt+Tab" title="Troca para a janela anterior."><i class="fas fa-clone"></i> Trocar janela <kbd>Alt+Tab</kbd></button>
        <button data-keys="Alt+F4" title="Fecha a janela ativa."><i class="fas fa-xmark"></i> Fechar janela <kbd>Alt+F4</kbd></button>
        <button data-keys="Meta+Shift+s" title="Ferramenta de recorte."><i class="fas fa-crop-simple"></i> Recorte de tela <kbd>Win+Shift+S</kbd></button>
        <button data-keys="Meta+l" title="Bloqueia o computador remoto."><i class="fas fa-lock"></i> Bloquear <kbd>Win+L</kbd></button>
        <div class="menu-note">Em tela cheia (Chrome/Edge) os atalhos do teclado vão direto para o computador remoto.</div>
    </div>

    <div id="fileTransferMenu" class="popup-menu">
        <button id="fileUploadButton"><i class="fas fa-upload"></i> Enviar arquivos para o computador</button>
        <button id="fileDownloadButton"><i class="fas fa-download"></i> Baixar arquivos do computador</button>
    </div>

    <div id="windowsSessionMenu" class="popup-menu">
        <div class="text-center" style="margin-bottom: 5px;">
            Trocar sessão do Windows
        </div>
        <select id="windowsSessionSelect"
                title="Trocar para outra sessão do Windows.">
        </select>
        <button id="restartButton" class="menu-action" title="Reinicia o computador e reconecta sozinho quando ele voltar.">
            <i class="fas fa-rotate-right"></i>
            Reiniciar e voltar
        </button>
        <button id="restartSafeButton" title="Reinicia em modo de segurança com rede (só uma vez) e reconecta sozinho.">
            <i class="fas fa-shield-halved"></i>
            Reiniciar em modo de segurança
        </button>
    </div>

    <div id="extrasMenu" class="popup-menu">

        <button id="audioButton"
                title="Somente Windows. Transmite o áudio remoto para o navegador.">
            <i class="fas fa-volume-up"></i>
            Áudio
        </button>

        <button id="inviteButton"
                title="Copiar um link para outra pessoa ver a tela remota.">
            <i class="fas fa-user-plus"></i>
            Convidar outras pessoas
        </button>

        <button id="typeClipboardButton" title="Digita um texto tecla por tecla. Use onde colar não funciona: login do Windows, UAC, BitLocker.">
            <i class="fas fa-keyboard"></i>
            Digitar texto...
        </button>

        <button id="clipboardSyncButton"
                title="Ctrl+C e Ctrl+V entre o seu computador e o remoto: texto e arquivos.">
            <i class="fas fa-arrows-rotate"></i>
            Copiar e colar automático
        </button>

        <button id="metricsButton"
            title="Mostrar/ocultar métricas da sessão.">
            <i class="fas fa-gauge"></i>
            Métricas
        </button>
    </div>

    <div id="metricsFrame" class="d-none">
        <div>
            Mbps:
        </div>
        <div id="mbpsDiv">
        </div>
        <div>
            FPS:
        </div>
        <div id="fpsDiv">
        </div>
        <div>
            Latência:
        </div>
        <div id="latencyDiv">
        </div>
        <div>
            GPU:
        </div>
        <div id="gpuAcceleratedDiv">
        </div>
    </div>

    <div class="connection-box-wrapper">
        <div class="text-center">
            <h2 id="connectHeader" class="connect-header" style="display: none">
                Conectar a um cliente
            </h2>
        </div>
        <div id="connectBox" class="center-connection-box" style="display: none">
            <form id="connectForm">
                <div class="form-block">
                    <label class="input-label">Seu nome (exibido para o cliente)</label>
                    <input id="nameInput" type="text" required value="@Model.UserDisplayName" />
                </div>
                <div class="form-block">
                    <label class="input-label">ID da sessão</label>
                    <input id="sessionIDInput" required type="text" pattern="[0-9 ]+" />
                </div>
                <div>
                    <button id="connectButton" disabled>
                        Conectar
                    </button>
                </div>

            </form>
        </div>

        <div id="statusMessage" class="status-message">
        </div>

    </div>

    <div id="workAreaGrid" style="display: none;">
        <div id="toolbarRow">
            <div id="menuFrame" class="open" role="toolbar" aria-label="Controle remoto">
                <div class="rc-identity" title="Computador conectado e tempo de sessão">
                    <span class="rc-live-dot"></span>
                    <div class="rc-identity-text">
                        <strong id="machineNameLabel">Conectando...</strong>
                        <span id="sessionTimerLabel">00:00</span>
                    </div>
                </div>

                <div class="rc-groups">
                    <div class="rc-group d-none" id="monitorGroup">
                        <button id="changeScreenButton" class="rc-btn"
                                title="Escolher o monitor do computador remoto.">
                            <i class="fas fa-desktop"></i>
                            <span class="rc-label">Monitores</span>
                        </button>
                        <div id="monitorButtons" class="rc-monitors"></div>
                    </div>

                    <div class="rc-group">
                        <button id="viewOnlyButton" class="rc-btn"
                                title="Somente visualizar: não envia mouse nem teclado ao computador remoto.">
                            <i class="fas fa-eye"></i>
                            <span class="rc-label">Só ver</span>
                        </button>

                        <button id="blockInputButton" class="rc-btn"
                                title="Bloquear o teclado e o mouse do usuário durante o acesso.">
                            <i class="fas fa-lock"></i>
                            <span class="rc-label">Bloquear usuário</span>
                        </button>

                        <button id="shortcutsButton" class="rc-btn"
                                title="Atalhos do Windows (Win+R, Alt+Tab, Ctrl+Alt+Del...) para o computador remoto.">
                            <i class="fas fa-keyboard"></i>
                            <span class="rc-label">Atalhos</span>
                        </button>

                        <button id="windowsSessionMenuButton" class="rc-btn d-none"
                                title="Sessões do Windows e reiniciar.">
                            <i class="fa-brands fa-windows"></i>
                            <span class="rc-label">Windows</span>
                        </button>

                        <button id="keyboardButton" class="rc-btn d-none"
                                title="Abrir o teclado virtual.">
                            <i class="fas fa-keyboard"></i>
                        </button>
                    </div>

                    <div class="rc-group">
                        <button id="clipboardTransferButton" class="rc-btn d-none" aria-hidden="true" tabindex="-1"></button>

                        <button id="fileTransferButton" class="rc-btn"
                                title="Enviar ou baixar arquivos.">
                            <i class="fas fa-file-arrow-up"></i>
                            <span class="rc-label">Arquivos</span>
                        </button>

                        <button id="panelButton" class="rc-btn d-none"
                                title="Painel do computador: dados, terminal, scripts e envio de arquivos.">
                            <i class="fas fa-table-columns"></i>
                            <span class="rc-label">Painel</span>
                        </button>
                    </div>

                    <div class="rc-group">
                        <button id="fitToScreenButton" class="rc-btn toggled"
                                title="Ajustar a imagem ao tamanho da janela (desligado: tamanho real, com rolagem).">
                            <i class="fas fa-compress"></i>
                        </button>

                        <button id="fullScreenButton" class="rc-btn"
                                title="Tela cheia. Nela, atalhos como Win e Alt+Tab vão para o computador remoto (segure Esc para sair).">
                            <i class="fas fa-maximize"></i>
                        </button>

                        <button id="extrasMenuButton" class="rc-btn" title="Mais opções.">
                            <i class="fas fa-ellipsis-vertical"></i>
                        </button>
                    </div>
                </div>

                <button id="disconnectButton" class="rc-btn rc-danger"
                        title="Encerrar o acesso.">
                    <i class="fas fa-power-off"></i>
                    <span class="rc-label">Encerrar</span>
                </button>
            </div>

            <button id="menuButton" class="open" title="Recolher ou mostrar a barra.">
                <i class="fas fa-chevron-up"></i>
            </button>
        </div>

        <div id="screenViewerWrapper">
            <canvas id="screenViewer" class="fit"></canvas>
            <input id="fileTransferInput" hidden="hidden" type="file" multiple />
            <input id="touchKeyboardInput" type="text" autocomplete="off" autocapitalize="off" />
        </div>

        <aside id="sidePanel" class="d-none" aria-label="Painel do computador">
            <div class="side-panel-head">
                <strong><i class="fas fa-table-columns"></i> Painel do computador</strong>
                <a id="sidePanelPopout" class="side-panel-icon" target="_blank" rel="noopener" title="Abrir a página do computador em outra aba">
                    <i class="fas fa-up-right-from-square"></i>
                </a>
                <button id="sidePanelClose" class="side-panel-icon" title="Fechar o painel">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <iframe id="sidePanelFrame" title="Painel do computador"></iframe>
        </aside>

        <div id="waitOverlay" class="d-none" role="status" aria-live="polite">
            <div class="wait-card">
                <div class="wait-spinner"><i class="fas fa-rotate"></i></div>
                <h2 id="waitOverlayTitle">Reiniciando o computador</h2>
                <p id="waitOverlayText">O acesso volta sozinho quando o computador ligar de novo.</p>
                <div id="waitOverlayTimer" class="wait-timer">00:00</div>
                <button id="waitOverlayCancel" class="wait-cancel">Parar de esperar e encerrar</button>
            </div>
        </div>
    </div>

    <div id="sessionEndedOverlay" class="d-none" role="status" aria-live="polite">
        <div class="wait-card">
            <div class="wait-spinner ended"><i class="fas fa-power-off"></i></div>
            <h2>Sessão encerrada</h2>
            <p id="sessionEndedText">A sessão de controle remoto terminou.</p>
            <p id="sessionEndedHint" class="ended-hint">Para acessar de novo, use o botão Controle remoto no painel.</p>
            <div class="ended-actions">
                <button id="sessionEndedReconnect" class="wait-primary d-none"><i class="fas fa-rotate"></i> Reconectar</button>
                <button id="sessionEndedClose" class="wait-cancel">Fechar esta aba</button>
            </div>
        </div>
    </div>

    <div id="toastsWrapper">
    </div>


    <div id="fileTransferDiv" hidden="hidden">
        <span id="fileTransferNameSpan" class="me-1 font-weight-bold" style="vertical-align: middle;"></span>
        <progress id="fileTransferProgress"></progress>
        <button id="fileTransferCancel" class="ft-cancel" title="Cancelar o envio">Cancelar</button>
    </div>

    <footer>
        <div class="copyright-text">
            Remotely · mantido por Michael Rodrigues · baseado no projeto original da Immense Networks
        </div>
    </footer>

    <script src="/src/v/@(Remotely.Server.Services.ViewerAssets.GetVersion(HostEnvironment))/App.js" type="module"></script>
    <script>
        window.addEventListener("load", () => {
            ViewerApp.Init();
        })
    </script>
</body>
</html>
