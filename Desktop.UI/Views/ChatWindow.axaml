<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Remotely.Desktop.UI.ViewModels"
        xmlns:v="clr-namespace:Remotely.Desktop.UI.Views"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DesignWidth="380" d:DesignHeight="580"
        x:Class="Remotely.Desktop.UI.Views.ChatWindow"
        x:DataType="vm:ChatWindowViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Icon="{Binding WindowIcon}"
        Width="380" Height="560"
        MinWidth="320" MinHeight="400"
        RequestedThemeVariant="Dark"
        Background="#0B1020"
        Foreground="#E2E8F0"
        WindowStartupLocation="Manual"
        DragDrop.AllowDrop="True">

  <!-- Mesmas cores, medidas e ícones do chat do visualizador (viewer-modern.css, seção "Chat da sessão"). -->
  <Window.Styles>
    <Style Selector="Button.ChatTool">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ChatTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2494A3B8" />
      <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="Button.ChatSend">
      <Setter Property="Background" Value="#4F46E5" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ChatSend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4338CA" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ChatPlain">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.ChatPlain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.EmojiTab">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.EmojiTab.Active">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="#406366F1" />
    </Style>
    <Style Selector="Button.Emoji">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Emoji:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2694A3B8" />
    </Style>
    <Style Selector="TextBox.ChatInput">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#3894A3B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MaxHeight" Value="140" />
    </Style>
    <Style Selector="TextBox.ChatInput:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#5994A3B8" />
    </Style>
    <Style Selector="TextBox.ChatInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#6366F1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="FlyoutPresenter.EmojiPicker">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#3394A3B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="MaxWidth" Value="346" />
    </Style>
  </Window.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,*,Auto,Auto">

      <!-- Cabeçalho: "Chat", com quem, "digitando..." e ocultar. -->
      <Border Grid.Row="0" BorderBrush="#2494A3B8" BorderThickness="0,0,0,1" Padding="14,10,10,10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static v:ChatIcons.Chat}" Width="14" Height="14" Foreground="#818CF8" />
              <TextBlock Text="Chat" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PeerName, StringFormat='· {0}'}" FontSize="13.5" Foreground="#94A3B8"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="230" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontStyle="{Binding StatusFontStyle}"
                       Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ChatTool" Width="30" Height="30" VerticalAlignment="Center"
                  Command="{Binding HideCommand}" IsVisible="{Binding CanHide}"
                  ToolTip.Tip="Ocultar o chat. A conversa continua e volta pelo botão Chat do painel.">
            <PathIcon Data="{x:Static v:ChatIcons.Close}" Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>

      <!-- Mensagens -->
      <Panel Grid.Row="1">
        <StackPanel IsVisible="{Binding HasNoMessages}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="260" Spacing="8">
          <PathIcon Data="{x:Static v:ChatIcons.Comments}" Width="40" Height="32" Foreground="#334155" />
          <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="#64748B" FontSize="13" />
        </StackPanel>
        <ScrollViewer x:Name="MessagesScroll" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Messages}" Margin="12,14,12,14">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatItemViewModel">
                <Border HorizontalAlignment="{Binding Alignment}"
                        Background="{Binding BubbleBrush}"
                        CornerRadius="{Binding BubbleCorners}"
                        Padding="10,7,10,5"
                        MaxWidth="290"
                        BoxShadow="0 1 1 0 #40000000">
                  <StackPanel Spacing="2">
                    <TextBlock IsVisible="{Binding ShowSender}" Text="{Binding Sender}" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="#A5B4FC" Margin="0,0,0,2" />

                    <ItemsControl ItemsSource="{Binding Attachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatAttachmentViewModel">
                          <StackPanel Margin="0,2,0,4" Spacing="2">
                            <Button IsVisible="{Binding HasImage}" Classes="ChatPlain" Command="{Binding OpenCommand}"
                                    ToolTip.Tip="{Binding FileName, StringFormat='{}{0} · clique para abrir'}">
                              <Border CornerRadius="10" ClipToBounds="True">
                                <Image Source="{Binding Image}" MaxHeight="240" MaxWidth="270" Stretch="Uniform" />
                              </Border>
                            </Button>
                            <Button IsVisible="{Binding ShowFileCard}" Classes="ChatPlain" Command="{Binding OpenCommand}"
                                    ToolTip.Tip="Abrir">
                              <Border Background="#730F172A" CornerRadius="10" Padding="10,8">
                                <Grid ColumnDefinitions="Auto,10,*,8,Auto">
                                  <PathIcon Data="{Binding Icon}" Width="18" Height="22" Foreground="#C7D2FE" />
                                  <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.7"
                                               Foreground="{Binding TextBrush}" />
                                  </StackPanel>
                                  <Button Grid.Column="4" Classes="ChatTool" Width="28" Height="28" VerticalAlignment="Center"
                                          Opacity="0.7" Command="{Binding SaveCommand}" IsVisible="{Binding !IsMine}"
                                          ToolTip.Tip="Salvar em Downloads">
                                    <PathIcon Data="{x:Static v:ChatIcons.Download}" Width="13" Height="13"
                                              Foreground="{Binding TextBrush}" />
                                  </Button>
                                </Grid>
                              </Border>
                            </Button>
                            <TextBlock IsVisible="{Binding HasStatus}" Text="{Binding StatusText}" FontSize="10.5"
                                       Opacity="0.7" HorizontalAlignment="Right" Foreground="{Binding TextBrush}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <v:ChatText IsVisible="{Binding HasText}" Message="{Binding Text}" TextWrapping="Wrap"
                                FontSize="{Binding TextSize}" Foreground="{Binding TextBrush}"
                                TextAlignment="{Binding TextAlignment}" LinkCommand="{Binding OpenLinkCommand}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,2,0,0"
                                IsVisible="{Binding !IsSystem}">
                      <TextBlock Text="{Binding TimeText}" FontSize="10.5" Opacity="0.7" Foreground="{Binding TextBrush}" />
                      <PathIcon IsVisible="{Binding ShowStatus}" Data="{Binding StatusIcon}" Width="11" Height="10"
                                Foreground="{Binding StatusBrush}" Opacity="{Binding StatusOpacity}"
                                ToolTip.Tip="{Binding StatusTip}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>

      <!-- Anexos ainda não enviados -->
      <ScrollViewer Grid.Row="2" IsVisible="{Binding HasPending}" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled" Padding="10,8,10,0">
        <ItemsControl ItemsSource="{Binding Pending}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PendingAttachmentViewModel">
              <Border Background="#1E293B" CornerRadius="8" Padding="6,4,4,4" MaxWidth="170">
                <Grid ColumnDefinitions="Auto,6,*,4,Auto">
                  <Panel Width="34" Height="34">
                    <Border IsVisible="{Binding HasThumbnail}" CornerRadius="6" ClipToBounds="True">
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <PathIcon IsVisible="{Binding !HasThumbnail}" Data="{Binding Icon}" Width="16" Height="20"
                              Foreground="#C7D2FE" />
                  </Panel>
                  <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                  <Button Grid.Column="4" Classes="ChatTool" Width="18" Height="18" CornerRadius="9"
                          VerticalAlignment="Top" Background="#4094A3B8" Foreground="#E2E8F0"
                          Command="{Binding RemoveCommand}" ToolTip.Tip="Remover">
                    <PathIcon Data="{x:Static v:ChatIcons.Close}" Width="7" Height="7" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Escrever -->
      <Border Grid.Row="3" BorderBrush="#2494A3B8" BorderThickness="0,1,0,0" Padding="10">
        <Grid ColumnDefinitions="Auto,4,Auto,4,*,4,Auto">
          <Button x:Name="EmojiButton" Grid.Column="0" Classes="ChatTool" ToolTip.Tip="Emojis">
            <PathIcon Data="{x:Static v:ChatIcons.Smile}" Width="16" Height="16" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="EmojiPicker">
                <StackPanel Spacing="6">
                  <Border BorderBrush="#2494A3B8" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding EmojiGroups}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmojiGroupViewModel">
                          <Button Classes="EmojiTab" Classes.Active="{Binding IsSelected}" Content="{Binding Icon}"
                                  Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedEmojiGroup.Emojis}" Width="312">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <Button Classes="Emoji" Content="{Binding}" Click="Emoji_Click" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="2" Classes="ChatTool" Command="{Binding AttachCommand}"
                  ToolTip.Tip="Anexar imagem ou documento (até 25 MB)">
            <PathIcon Data="{x:Static v:ChatIcons.Attach}" Width="14" Height="16" />
          </Button>
          <TextBox Grid.Column="4" x:Name="InputBox" Classes="ChatInput" Text="{Binding InputText}" Watermark="Mensagem"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                   MaxLength="4000" />
          <Button Grid.Column="6" Classes="ChatTool ChatSend" Command="{Binding SendCommand}" ToolTip.Tip="Enviar (Enter)">
            <PathIcon Data="{x:Static v:ChatIcons.Send}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Arrastando arquivos para cima da janela -->
    <Panel x:Name="DropHint" IsVisible="False" IsHitTestVisible="False">
      <Rectangle Stroke="#6366F1" StrokeThickness="2" StrokeDashArray="4,3" Fill="#2E4F46E5" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <PathIcon Data="{x:Static v:ChatIcons.Attach}" Width="14" Height="16" Foreground="#E0E7FF" />
        <TextBlock Text="Solte para anexar" FontWeight="SemiBold" Foreground="#E0E7FF" />
      </StackPanel>
    </Panel>
  </Panel>
</Window>
