<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Remotely.Desktop.UI.ViewModels"
        xmlns:fakes="clr-namespace:Remotely.Desktop.UI.ViewModels.Fakes"
        xmlns:v="clr-namespace:Remotely.Desktop.UI.Views"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="170"
        x:Class="Remotely.Desktop.UI.Views.SessionIndicatorWindow"
        x:DataType="vm:ISessionIndicatorWindowViewModel"
        Title="Acesso remoto"
        Icon="{Binding WindowIcon}"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="True"
        SizeToContent="WidthAndHeight">

  <Design.DataContext>
    <fakes:FakeSessionIndicatorWindowViewModel />
  </Design.DataContext>

  <Panel>
    <!-- Painel aberto: quem está conectado, há quanto tempo, ocultar e encerrar. -->
    <Border IsVisible="{Binding IsExpanded}"
            Background="#FFFFFF"
            BorderBrush="#C7D2FE"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14"
            Width="360"
            Margin="8"
            BoxShadow="0 8 24 0 #33111827">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,12,*">
          <Panel Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="20" Background="#E0E7FF">
              <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="14" Foreground="#3730A3"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Width="12" Height="12" CornerRadius="6" Background="#22C55E" BorderBrush="White" BorderThickness="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Panel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding TechnicianName}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ElapsedText}" FontSize="11.5" Foreground="#6B7280" />
          </StackPanel>
        </Grid>

        <!-- Mensagem nova do chat (ou "digitando...") enquanto a janela do chat está fechada. -->
        <Button IsVisible="{Binding HasChatPreview}" Classes="ChatPreview" Command="{Binding OpenChatCommand}"
                ToolTip.Tip="Abrir o chat">
          <Grid ColumnDefinitions="Auto,8,*,8,Auto">
            <PathIcon Data="{x:Static v:ChatIcons.Chat}" Width="14" Height="14" Foreground="#4F46E5" />
            <TextBlock Grid.Column="2" Text="{Binding ChatPreview}" FontSize="12.5" Foreground="#312E81"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="Responder" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5"
                       VerticalAlignment="Center" IsVisible="{Binding HasUnreadChats}" />
          </Grid>
        </Button>

        <!-- Ações normais -->
        <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" IsVisible="{Binding !IsConfirming}">
          <Button Grid.Column="0" Classes="Link" Command="{Binding HideCommand}"
                  ToolTip.Tip="Recolhe o painel para a lateral da tela. O acesso continua.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="M 0,0 L 4,4 L 0,8" Stroke="#6B7280" StrokeThickness="1.6" VerticalAlignment="Center" />
              <TextBlock Text="Ocultar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="Ghost" Classes.Active="{Binding IsChatOpen}" Command="{Binding ToggleChatCommand}"
                  ToolTip.Tip="Conversar com o técnico: mensagens, emojis, imagens e documentos. Clique de novo para ocultar.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static v:ChatIcons.Chat}" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Text="Chat" VerticalAlignment="Center" />
              <Border IsVisible="{Binding HasUnreadChats}" Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0">
                <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Classes="SoftDanger" Content="Encerrar acesso" Command="{Binding EndSessionCommand}" />
        </Grid>

        <!-- Confirmação no próprio painel (sem outra janela na frente do usuário). -->
        <Border IsVisible="{Binding IsConfirming}" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                CornerRadius="10" Padding="12,10">
          <StackPanel Spacing="10">
            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#7F1D1D">
              <Run Text="Encerrar o acesso agora?" FontWeight="SemiBold" />
              <LineBreak />
              <Run Text="O técnico será desconectado deste computador." />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="Ghost" Content="Continuar" Command="{Binding CancelEndCommand}" />
              <Button Classes="Danger" Content="Encerrar" Command="{Binding ConfirmEndCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Painel oculto: só uma aba na lateral direita para mostrar de novo. -->
    <Button IsVisible="{Binding IsCollapsed}"
            Classes="Tab"
            Command="{Binding ShowCommand}"
            Margin="0,8,0,8"
            Width="40"
            Height="96"
            ToolTip.Tip="Acesso remoto em andamento. Clique para mostrar o painel.">
      <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path Data="M 4,0 L 0,4 L 4,8" Stroke="White" StrokeThickness="1.8" HorizontalAlignment="Center" />
        <Border Width="28" Height="28" CornerRadius="14" Background="#E0E7FF">
          <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="11" Foreground="#3730A3"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Width="9" Height="9" CornerRadius="5" Background="#22C55E" HorizontalAlignment="Center" />
        <Border IsVisible="{Binding HasUnreadChats}" Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16"
                Padding="3,0" HorizontalAlignment="Center" ToolTip.Tip="Mensagens novas no chat: clique para abrir">
          <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="10" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Button>
  </Panel>
</Window>
