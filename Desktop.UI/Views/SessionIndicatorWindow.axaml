<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Remotely.Desktop.UI.ViewModels"
        xmlns:fakes="clr-namespace:Remotely.Desktop.UI.ViewModels.Fakes"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="130"
        x:Class="Remotely.Desktop.UI.Views.SessionIndicatorWindow"
        x:DataType="vm:ISessionIndicatorWindowViewModel"
        Title="{Binding ProductName}"
        Icon="{Binding WindowIcon}"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="True"
        SizeToContent="WidthAndHeight">

  <Design.DataContext>
    <fakes:FakeSessionIndicatorWindowViewModel />
  </Design.DataContext>

  <!-- Painel do canto da tela: sempre visível enquanto houver acesso remoto. -->
  <Border Background="#FFFFFF"
          BorderBrush="#6366F1"
          BorderThickness="2"
          CornerRadius="10"
          Padding="14,12"
          Width="300">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="Auto,10,*">
        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#E0E7FF" VerticalAlignment="Center">
          <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="14" Foreground="#3730A3"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding TechnicianName}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding StatusText}" />
            <Run Text=" · " />
            <Run Text="{Binding ElapsedText}" />
          </TextBlock>
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Content="Encerrar acesso"
                Command="{Binding EndSessionCommand}"
                Background="#FEE2E2"
                Foreground="#991B1B"
                BorderBrush="#DC2626"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,5"
                FontWeight="SemiBold"
                Cursor="Hand" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
