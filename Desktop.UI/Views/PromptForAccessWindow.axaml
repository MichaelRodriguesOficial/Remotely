<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Remotely.Desktop.UI.ViewModels"
        xmlns:fakes="clr-namespace:Remotely.Desktop.UI.ViewModels.Fakes"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="260"
        x:Class="Remotely.Desktop.UI.Views.PromptForAccessWindow"
        x:DataType="vm:IPromptForAccessWindowViewModel"
        x:Name="PromptForAccessWindowRef"
        Title="Pedido de acesso remoto"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        Icon="{Binding WindowIcon}">

  <Design.DataContext>
    <fakes:FakePromptForAccessViewModel />
  </Design.DataContext>

  <Border Background="#FFFFFF"
          BorderBrush="#C7D2FE"
          BorderThickness="1"
          CornerRadius="14"
          Padding="22,20"
          Width="440"
          Margin="12"
          BoxShadow="0 16 40 0 #4D111827">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,14,*">
        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#E0E7FF" VerticalAlignment="Top">
          <Path Data="M 10,1 L 18,4 L 18,10 C 18,15 14.5,18.5 10,20 C 5.5,18.5 2,15 2,10 L 2,4 Z"
                Fill="#4F46E5" Width="20" Height="21" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Text="PEDIDO DE ACESSO REMOTO" FontSize="11" FontWeight="SemiBold" Foreground="#6366F1" />
          <TextBlock Text="O suporte de TI quer acessar este computador" FontSize="17" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RequestMessage}" FontSize="13" Foreground="#374151" TextWrapping="Wrap" LineHeight="19" />
        </StackPanel>
      </Grid>

      <Border IsVisible="{Binding HasCountdown}" Background="#EEF2FF" CornerRadius="8" Padding="12,8">
        <TextBlock Text="{Binding CountdownText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#4338CA" TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="Ghost" Content="Recusar" MinWidth="100"
                Command="{Binding SetResultNo}"
                CommandParameter="{Binding #PromptForAccessWindowRef}" />
        <Button Classes="Primary" Content="Permitir acesso" MinWidth="120"
                Command="{Binding SetResultYes}"
                CommandParameter="{Binding #PromptForAccessWindowRef}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
