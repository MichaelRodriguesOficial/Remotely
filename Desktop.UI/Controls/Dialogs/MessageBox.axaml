<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="200"
        xmlns:vm="clr-namespace:Remotely.Desktop.UI.ViewModels"
        xmlns:fakes="clr-namespace:Remotely.Desktop.UI.ViewModels.Fakes"
        x:Class="Remotely.Desktop.UI.Controls.Dialogs.MessageBox"
        Icon="{Binding WindowIcon}"
        Title="{Binding Caption}"
        Topmost="True"
        ShowActivated="True"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        x:DataType="vm:MessageBoxViewModel"
        x:Name="MessageBoxWindow"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <fakes:FakeMessageBoxViewModel />
  </Design.DataContext>

  <!-- Aviso no mesmo visual do painel do canto da tela. -->
  <Border Background="#FFFFFF"
          BorderBrush="#E5E7EB"
          BorderThickness="1"
          CornerRadius="12"
          Padding="20,18"
          Width="400"
          Margin="12"
          BoxShadow="0 12 32 0 #40111827">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,12,*">
        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#E0E7FF" VerticalAlignment="Top">
          <TextBlock Text="i" FontWeight="Bold" FontSize="16" Foreground="#4338CA"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" FontSize="15" Foreground="#111827" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#374151" TextWrapping="Wrap" LineHeight="19" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="Primary" IsVisible="{Binding IsOkButtonVisible}"
                Command="{Binding OKCommand}"
                CommandParameter="{Binding #MessageBoxWindow}"
                Content="OK" MinWidth="80" />
        <Button Classes="Ghost" IsVisible="{Binding AreYesNoButtonsVisible}"
                Command="{Binding NoCommand}"
                CommandParameter="{Binding #MessageBoxWindow}"
                Content="Não" MinWidth="80" />
        <Button Classes="Primary" IsVisible="{Binding AreYesNoButtonsVisible}"
                Command="{Binding YesCommand}"
                CommandParameter="{Binding #MessageBoxWindow}"
                Content="Sim" MinWidth="80" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
