# Copie para ".env" (na mesma pasta do docker-compose.yml) e ajuste.

# Imagem e versão
REMOTELY_IMAGE=michechel10/remotely
REMOTELY_TAG=1.2.0

# Porta publicada no host. Use REMOTELY_BIND=127.0.0.1 quando houver
# proxy reverso (Nginx/Caddy) com HTTPS na frente.
REMOTELY_BIND=0.0.0.0
REMOTELY_PORT=5000

TZ=America/Sao_Paulo

# Banco: SQLite | SQLServer | PostgreSQL
REMOTELY_DB_PROVIDER=SQLite
# Preencha apenas se usar SQL Server ou PostgreSQL:
REMOTELY_SQLSERVER_CONNECTION=
REMOTELY_POSTGRES_CONNECTION=

# Segurança
# Documentação da API em /swagger (abre só para usuários logados no painel)
REMOTELY_ENABLE_SWAGGER=true
# Origens que podem exibir o Remotely em iframe (ex.: https://glpi.suaempresa.com.br)
REMOTELY_ALLOWED_FRAME_ANCESTORS=
# Tentativas de login/registro por IP por minuto
REMOTELY_AUTH_RATE_LIMIT=20
